# -- Three rules (details: references/project-skeleton.md section 4) --
# (1) Build output / generated artifacts never enter the repo; whether codegen output is
#     committed is decided per project, item by item
# (2) A pattern containing a slash is anchored to the directory holding this file, so a
#     subdirectory needs its own .gitignore or must switch to the trailing-slash form
# (3) Do not use `git check-ignore <dir>/` as the criterion (it misreports directories);
#     the authoritative check is `git add -A --dry-run`

# Dependencies and build output
.dart_tool/
build/
*.iml

# Python bytecode caches (generated as soon as content/tools/*.py is imported)
# The trailing-slash form contains no inner slash, so it is not anchored and covers any
# depth; no extra .gitignore is needed in subdirectories
__pycache__/
*.pyc

# Content-pack artifacts (produced by content/tools/build.py, must be built locally)
content/*/dist/
# fixtures is also a source directory and can be built directly; the rule above covers
# only one level, hence this separate entry
content/tools/fixtures/*/dist/

# Single-file pack (generated by `content/tools/assemble_pack.py`). **Never committed**: it
# is a projection of the source data, and committing it creates a second source of truth --
# edit the source, forget to rebuild, and no assertion will ever go red.
# The client probes `<pack root>/pack.json` relative to the runtime CWD (`SPEC-PACK-018`),
# so rebuild it every time. The leading slash anchors to the repo root and matches
# `content/<space>/pack.json` at one level only; `content/tools/fixtures/*/pack.json` holds
# hand-written fixtures and **must stay in the repo**.
/content/*/pack.json

# Server-side secrets (injected via environment variables in production, never committed)
config/passwords.yaml
config/development.yaml
config/*.local.yaml

# Logs and temporary directories
*.log
# batch flow state and merge audit (never committed)
.batch/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Flutter / platform build by-products
app/windows/flutter/ephemeral/
app/macos/Flutter/ephemeral/
app/ios/Flutter/ephemeral/
**/Pods/
**/.symlinks/
