#!/usr/bin/env bash
# Commit message checker -- one file shared by the local hook and CI.
#
# Only docs/specs/git-conventions.md §3 applies:
#   §3.1 type, 11 values (required)
#   §3.2 scope, 6 values (required; one of the six, sub-dimensions never in scope)
#   §3.3 subject <= 72 chars, no trailing period; one blank line between header and body
#        footer must carry a DCO sign-off: a line starting with
#        `Signed-off-by: Name <email>` (`git commit -s`)
#
# Usage:
#   .githooks/commit-msg <msg-file>           # git hook, single message
#   .githooks/commit-msg --range <rev-range>  # CI, per commit (merges pass)
#
# Exit codes: 0 pass, 1 violation.
#
# -- Why shell instead of folding this into app/tool/lint (Dart) --------------
# The `repo-hygiene` job installs no Flutter/Dart and has a 5 s budget. Pulling
# in an SDK for one regex would turn the cheapest check into the most expensive
# one. bash exists on both ends.
#
# -- Why both ends must share this one file ----------------------------------
# Splitting it has a concrete cost: local passes, CI fails, people edit CI
# instead of the commit; CI passes, local fails, people reach for
# `--no-verify`. Two copies of a criterion mean no criterion.

set -u

# WARNING: this is ERE (`grep -E`); the separator must be a bare `|`. Writing
# `\|` is the BRE "or", which in ERE is just a literal pipe -- the regex then
# never matches and every commit in the repo is rejected.
TYPES='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
SCOPES='app|server|pack|docs|infra|repo'
MAX=72

# WARNING: all four regexes must go through variables first. Inlined into
# `[[ s =~ ... ]]`, bash parses the `[^)]` inside the regex as the closing
# paren of the conditional and dies with
# `syntax error ... unexpected token )`. The trap only applies to inline regex
# in `[[ ]]`; a variable sidesteps it.
# The scope group has no `?`: scope is required and must be one of SCOPES.
HEADER_RE="^(${TYPES})\([a-z/]+\)!?:\ .+\$"
# Only used to report "missing scope" precisely: when the shape fails, this
# regex splits that one case off from a general shape error.
NO_SCOPE_RE="^(${TYPES})!?:\ .+\$"
SCOPE_RE='^[a-z]+\(([^)]+)\)'
SCOPE_OK_RE="^(${SCOPES})\$"

# WARNING: characters vs bytes. `${#s}` counts characters under a UTF-8 locale
# and bytes under C/POSIX (one CJK char = 3 bytes). The same 60-char Chinese
# subject scores 60 in one case and 180 in the other -- the check would give
# opposite verdicts on two machines with no visible reason. Probe once here and
# refuse to run under a byte-counting locale instead of measuring wrongly.
PROBE='中'
if [ "${#PROBE}" -ne 1 ]; then
  echo "commit-msg: 当前 locale 不是 UTF-8（\`\${#s}\` 按字节计数，本应是 1 得到 ${#PROBE}），无法正确度量 subject 长度。" >&2
  echo "commit-msg: 设 LANG=C.UTF-8（或 en_US.UTF-8）后重试。" >&2
  exit 1
fi

FAIL=0

# Message shapes this check does not own:
#   Merge / Revert           -- fixed phrasing produced by git and the platform
#   fixup! / squash! / amend! -- rebase intermediates, folded away later
skip_msg() {
  case "$1" in
    'Merge '* | 'Revert "'* | 'fixup! '* | 'squash! '* | 'amend! '*) return 0 ;;
    *) return 1 ;;
  esac
}

# The argument is the full message, not a file name -- the whole path stays in
# bash builtins, no forks. Per-message `sed` / `grep` costs ~100 ms per fork on
# Windows and four external calls per message; a hundred-commit PR spends tens
# of seconds. This check is meant to be cheaper than check-ignore.
check_msg() {
  local msg=$1 label=$2
  local first second rest scope subject len

  # Strip CRLF: `core.autocrlf` on Windows may store the message with CRLF and
  # a stray \r, which breaks both the "no trailing period" and the "second line
  # is blank" checks.
  msg=${msg//$'\r'/}
  # Strip trailing newlines so the last line is not mistaken for a blank line
  while [ "${msg%$'\n'}" != "$msg" ]; do msg=${msg%$'\n'}; done

  first=${msg%%$'\n'*}
  if [ "$first" = "$msg" ]; then
    second=''
  else
    rest=${msg#*$'\n'}
    second=${rest%%$'\n'*}
  fi

  if [ -z "$first" ]; then
    echo "FAIL $label: 首行为空" >&2
    FAIL=1
    return
  fi

  if skip_msg "$first"; then
    return
  fi

  # (1) header shape: <type>(<scope>): <subject>, scope required.
  #     Shape is matched first with `[a-z/]+`, the value is checked separately:
  #     two steps keep the message accurate, because "wrong shape" and "value
  #     not in the six" need different fixes. "Missing scope" is its own branch:
  #     it differs from a shape error by one pair of parens, and a combined
  #     message does not lead to the right fix.
  if [[ ! $first =~ $HEADER_RE ]]; then
    if [[ $first =~ $NO_SCOPE_RE ]]; then
      echo "FAIL $label: 缺 scope —— 形态是 \`<type>(<scope>): <subject>\`，§3.2 中 scope 必填" >&2
      echo "      实得：$first" >&2
      echo "      取值：app / server / pack / docs / infra / repo（子维度不进 scope）" >&2
      FAIL=1
      return
    fi
    echo "FAIL $label: header 不符合 \`<type>(<scope>): <subject>\`" >&2
    echo "      实得：$first" >&2
    case "$first" in
      *\(*[A-Z_]*\)*) echo "      提示：scope 只能是小写字母" >&2 ;;
    esac
    FAIL=1
    return
  fi

  if [[ $first =~ $SCOPE_RE ]]; then
    scope=${BASH_REMATCH[1]}
    if [[ ! $scope =~ $SCOPE_OK_RE ]]; then
      echo "FAIL $label: scope \`$scope\` 不在 §3.2 的 6 值内（app / server / pack / docs / infra / repo）" >&2
      case "$scope" in
        */*) echo "      子维度不进 scope：\`$scope\` 是目录或子模块名，不是顶层单元" >&2 ;;
        *) echo "      view / plan / core / tool / test 归 \`app\`；content 归 \`pack\`；笔号与交付物归 \`docs\`" >&2 ;;
      esac
      FAIL=1
      return
    fi
  fi

  # (2) subject: non-empty, <= 72 chars, no trailing period
  subject=${first#*: }
  if [ "$subject" = "$first" ]; then
    echo "FAIL $label: 缺 \`: \` 与 subject" >&2
    FAIL=1
    return
  fi
  len=${#subject}
  if [ "$len" -gt "$MAX" ]; then
    echo "FAIL $label: subject ${len} 字符，超过 ${MAX}（按字符数计，不按显示宽度）" >&2
    echo "      实得：$subject" >&2
    FAIL=1
  fi
  case "$subject" in
    *。 | *.)
      echo "FAIL $label: subject 句尾不得加句号" >&2
      FAIL=1
      ;;
  esac

  # (3) one blank line between header and body. Only the second line is read:
  #     with no body there is nothing there, which is also blank -- both cases
  #     pass.
  if [ -n "$second" ]; then
    echo "FAIL $label: header 与 body 之间必须空一行" >&2
    echo "      第二行：$second" >&2
    FAIL=1
  fi

  # (4) DCO sign-off (§3.3): the message must contain a line that STARTS with
  #     `Signed-off-by: ` and carries a non-empty value. Reading line by line
  #     encodes "line start" -- matching `$'\n'Signed-off-by:` with `case` also
  #     works, but combining it with a negated class like `[! ]` makes bash's
  #     parser report `syntax error near unexpected token ']*'` (already hit).
  #     Reading is builtin, no fork.
  local line dco=0
  while IFS= read -r line; do
    case "$line" in
      'Signed-off-by: '*)
        rest=${line#Signed-off-by: }
        case "${rest// /}" in
          '') ;;
          *) dco=1 ;;
        esac
        ;;
    esac
  done <<<"$msg"

  if [ "$dco" -eq 0 ]; then
    echo "FAIL $label: 缺 \`Signed-off-by:\` 签署行（§3.3 每笔必带）" >&2
    echo "      解法：git commit -s；已提交未推送则 git commit --amend -s --no-edit" >&2
    FAIL=1
  fi
}

mode=${1:-}
if [ "$mode" = '--range' ]; then
  range=${2:-}
  if [ -z "$range" ]; then
    echo "usage: $0 --range <rev-range>" >&2
    exit 1
  fi
  # On a branch's first push GitHub sends an all-zero `before`, so the range
  # becomes `0000...0000..<sha>`. rev-list fails on that, and the error has
  # nothing to do with message compliance -- degrade to "check this one commit"
  # here instead of going red on a misleading error.
  case "$range" in
    *0000000000000000000000000000000000000000*)
      range="-n 1 ${range##*..}"
      ;;
  esac

  # Fetch every message in ONE call, NUL-separated. Looping `git log -1` costs
  # ~100 ms per commit on Windows; a hundred-commit PR takes tens of seconds,
  # while this check is budgeted at "cheaper than check-ignore".
  tmp=$(mktemp)
  # shellcheck disable=SC2086
  if ! git log --format='%H%n%B%x00' $range >"$tmp" 2>/dev/null; then
    echo "FAIL 无法解析区间 \`$range\`（base 是否已 fetch？fetch-depth 是否够？）" >&2
    rm -f "$tmp"
    exit 1
  fi
  if [ ! -s "$tmp" ]; then
    echo "提交信息：区间内无提交，跳过"
    rm -f "$tmp"
    exit 0
  fi

  n=0
  while IFS= read -r -d '' block; do
    # WARNING: after each record git appends a newline besides `%x00`, so every
    # block after the first starts with a newline. Not stripping it makes
    # `%%$'\n'*` return an empty "first line" and the SHA below it becomes the
    # header -- seen as "checked 99 commits, every one failed the header shape
    # with an empty label".
    block=${block#$'\n'}
    [ -z "$block" ] && continue
    sha=${block%%$'\n'*}
    n=$((n + 1))
    check_msg "${block#*$'\n'}" "$(printf '%.7s' "$sha")"
  done <"$tmp"
  rm -f "$tmp"
  echo "提交信息：校验 ${n} 条"
else
  if [ -z "$mode" ]; then
    echo "usage: $0 <msg-file> | $0 --range <rev-range>" >&2
    exit 1
  fi
  if [ ! -f "$mode" ]; then
    echo "FAIL 找不到消息文件：$mode" >&2
    exit 1
  fi
  check_msg "$(cat "$mode")" 'HEAD'
fi

if [ "$FAIL" -ne 0 ]; then
  echo '' >&2
  echo '提交信息不符合 docs/specs/git-conventions.md §三（3.1–3.3）。改正后无需重跑测试。' >&2
  exit 1
fi
exit 0
