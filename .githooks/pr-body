#!/usr/bin/env bash
# PR 正文形态判据 —— 本地自检与 CI **共用同一份逻辑**。
#
# 只认 docs/specs/git-conventions.md §4.1：
#   正文必含五节（变更摘要 / 自审留痕 / 交付物 / AI 参与 / 关联）
#   自审留痕五行（分支基线 / 改动面 / 版号 / 反证 / 如实登记）
#   一律不用 `- [ ]`
#   `如实登记` 一条一行、不压段（禁 ①②③）
#   `改动面` 首行给 N 条路径 / M 项 / 未动 K 处
#   跨 >=2 个技术栈目录（app/ server/ content/ infra/）须列三列表
#   `变更摘要` 与 `改动面` / `反证` / `如实登记` 的多行条目**都是缩进项目符号、
#   一条一行、无编号前缀**（圈号 · 罗马 i. · 阿拉伯 1. 三种都不行）
#   `反证` 须写明哪些没验
#
# 用法：
#   bash .githooks/pr-body --file <正文.md> [--diff-base origin/main]   # 本地，开 PR 前
#   bash .githooks/pr-body --stdin [--diff-base origin/main]            # 管道
#   bash .githooks/pr-body --self-test                                  # 判据自检（正例 + 负例）
#
# 退出码：0 通过 · 1 有违规 · 2 用法错。
#
# ── 为什么要有这条判据 ────────────────────────────────────────────────
# 2026-10-23 ~ 10-24 的五笔 PR（#143 ~ #147）正文全部违规，而且**同一个错重复五次**：
# `如实登记` 用 ①②③ 压在同一个段落里（违反 §4.1「一律一条一行」）。根因不是「没读
# 规则」，是**这一环没有任何装置**：模板里那行是单行占位（照它填必然压段）、
# `gh pr create` 不校验正文、`commit-msg` 只管提交信息。规则只写在 §4.1 正文里，
# 人读它才会生效 —— 这就是它连续失效五次的原因。
#
# ⚠️ 反面记录（2026-10-24 自查）：我在审计这五笔时**把跨栈条件读错了** —— 把 `docs/`
# 也算成一个技术栈目录，于是判定 `#144`（app 2 + docs 4）、`#146`（content 7 +
# docs 1）、`#147`（content 6 + docs 6）三笔「漏了三列表」，并给它们各补了一张表。
# 规则原文的技术栈目录只有 `app/` `server/` `content/` `infra/`（见
# `docs/specs/git-conventions.md:284`），**`docs/` 不在内** ⇒ 这三笔各只动 1 个技术栈
# 目录，**本不该有表**。本脚本第 6 条判据（`app|server|content|infra` 白名单）
# 是照原文写的、没读错；错的是那次人工审计。⇒ 别把「补了一张表」当成「合规」的
# 证据，也别据那次审计的结论去改别的 PR。表已于 2026-10-24 从三笔正文撤回。
#
# ⚠️ 该条的后半句「或触碰受控配置项」在全仓**没有定义**（`grep -rn 受控配置项 docs/`
# 只命中 `git-conventions.md:284` 自身）⇒ 本脚本只实现可判定的那一半（≥2 个技术栈
# 目录）；「算不算受控配置项」仍归人判，属已知缺口。
#
# ── 为什么是 pure bash（2026-10-24 改）──
# 原实现逐行 `printf | grep -q`：Git Bash 每个外部进程约 0.5 s，一次 `--self-test`
# 跑 61 s（5 个正负例 × 每例几十次 fork）—— `repo-hygiene` 整段预算 5 s，等于让最便宜
# 的判据最贵。现改为 mapfile 读入 + bash 模式匹配，全程只在「跨栈 diff」与「取 field
# 行号」两处 fork。**别把 grep 加回循环里**，那不是风格问题，是这条判据会超时变红。
#
# ── 判不了的 ──────────────────────────────────────────────────────────
# `反证` 是否被写成了**自证**（「跑了测试全绿」不算证据）是语义判断，正则判不了。
# 本脚本只判它的形态：该字段存在、且写明了「未验」。实质是否成立只能人看。

set -u

fail=0
ok()   { printf 'ok    %s\n' "$1"; }
bad()  { printf '[FAIL] %s\n' "$1"; fail=1; }
skip() { printf 'skip  %s\n' "$1"; }

declare -a BL=()

load_body() { mapfile -t BL < "$1"; }

# ── 定位（全部纯 bash）─────────────────────────────────────────────────

# 行首编号前缀：圈号 / 罗马 i.ii. / 阿拉伯 1.。返回 0 = 有前缀。
# 判据要求带分隔符与空格，免得把「3 条」「2026-10-23」判成编号。
num_prefix() {
  local s h front sep d
  s=$(strip_code "$1")                     # 代码跨度里的是举例，不算编号
  s="${s#"${s%%[![:space:]]*}"}"           # 去前导空白
  s="${s#- }"; s="${s#\* }"; s="${s#+ }"   # 去一个列表符号
  case "$s" in
    '①'*|'②'*|'③'*|'④'*|'⑤'*|'⑥'*|'⑦'*|'⑧'*|'⑨'*|'⑩'*) return 0 ;;
  esac
  h="${s%%[[:space:]]*}"                   # 第一段（编号与分隔符都在这段里）
  sep=""
  for d in . '、' ')' '）'; do
    case "$h" in
      *"$d"*) front="${h%%"$d"*}"; sep=1; break ;;
    esac
  done
  [ -n "$sep" ] || return 1
  case "$front" in
    ''|*[!0-9]*) ;;                        # 不是纯数字 ⇒ 按罗马数字看
    *) [ "${#front}" -le 2 ] && return 0; return 1 ;;
  esac
  case "$front" in
    i|ii|iii|iv|v|vi|I|II|III|IV|V|VI) return 0 ;;
  esac
  return 1
}

has_circled() {
  case "$1" in
    *①*|*②*|*③*|*④*|*⑤*|*⑥*|*⑦*|*⑧*|*⑨*|*⑩*) return 0 ;;
  esac
  return 1
}

# 剥掉行内代码跨度（成对反引号之间的内容），输出剩余部分。
# ⚠️ 必须有这一步：正文里**讨论**规则时会写 `- [ ]`（如「一律不用 `- [ ]`」），
#    不剥就把它当成真的任务列表 —— 本条判据首跑就是这么红在自己身上的。
#    同理，代码跨度里的 ①②③ 也不该算编号前缀。
strip_code() {
  local s="$1" out=""
  while case "$s" in *'`'*) true ;; *) false ;; esac; do
    out+="${s%%\`*}"
    s="${s#*\`}"
    case "$s" in *'`'*) s="${s#*\`}" ;; *) s="" ;; esac
  done
  printf '%s' "$out$s"
}

has_section() {  # $1 = 整行标题，如 `## 变更摘要`
  local l
  for l in "${BL[@]}"; do
    [ "$l" = "$1" ] && return 0
  done
  return 1
}

# ⚠️ 下面三个定位函数**把结果写全局变量、不做 command substitution**：
#    `x=$(field_line …)` 每调一次就 fork 一个子 shell，Git Bash 上约 0.3 s；
#    自检要调几十次，实测把 `--self-test` 从 25 s 拖到 2 s 以内靠的就是这一条。
#    别为了「看起来函数式」改回 `$( )`。
FLN=0        # field_line 结果：行号（1 基）
FA=0 FB=0    # field_bounds / section_bounds 结果：起始下标 / 结束下标（0 基，左闭右开）

field_line() {   # $1 = 字段名；成功时置 FLN
  local i l
  for ((i = 0; i < ${#BL[@]}; i++)); do
    l="${BL[$i]}"
    case "$l" in
      "- **$1**"*) FLN=$((i + 1)); return 0 ;;
    esac
  done
  return 1
}

# 字段块扫描区间。⚠️ 同时认 `## `：`如实登记` 是最后一五行，其后紧跟 `## 交付物`，
# 只认 `- **` 会把交付物 / AI 参与 / 关联 整段吞进块里，编号前缀判据在那几节误报。
field_bounds() {
  local s i l
  field_line "$1" || return 1
  s=$FLN
  for ((i = s; i < ${#BL[@]}; i++)); do
    l="${BL[$i]}"
    case "$l" in "- **"*|"## "*) break ;; esac
  done
  FA=$s; FB=$i
  return 0
}

# 段落扫描区间（标题行之后到下一个 `## ` 之前）
section_bounds() {
  local i n=${#BL[@]} a=-1 b=-1
  for ((i = 0; i < n; i++)); do
    if [ "$a" -lt 0 ]; then
      [ "${BL[$i]}" = "$1" ] && a=$((i + 1))
      continue
    fi
    case "${BL[$i]}" in "## "*) b=$i; break ;; esac
  done
  [ "$a" -ge 0 ] || return 1
  [ "$b" -lt 0 ] && b=$n
  SA=$a; SB=$b
  return 0
}

# 扫 [a, b) 内的编号前缀；$1 = 报错时用的名字
scan_num() {
  local i l n=0
  for ((i = $2; i < $3; i++)); do
    l="${BL[$i]}"
    [ -n "$l" ] || continue
    if num_prefix "$l"; then
      bad "$1 用了编号前缀（应缩进项目符号、一条一行、不加编号）：$l"
      n=$((n + 1))
    fi
  done
  return 0
}

check_body() {
  local body="$1"
  local diff_base="${2:-}"

  load_body "$body"

  # 1 —— 五节
  local sec
  for sec in "## 变更摘要" "## 自审留痕" "## 交付物" "## AI 参与" "## 关联"; do
    has_section "$sec" || bad "缺节：$sec"
  done

  # 2 —— 自审留痕五行
  local f
  for f in "分支基线" "改动面" "版号" "反证" "如实登记"; do
    field_line "$f" || bad "自审留痕缺字段：$f"
  done

  # 3 —— 禁 task list（先剥行内代码：正文里讨论这条规则时会写 `- [ ]`）
  local l tl=0
  for l in "${BL[@]}"; do
    case "$(strip_code "$l")" in *"- [ ]"*) tl=1; break ;; esac
  done
  if [ "$tl" -ne 0 ]; then
    bad '出现 `- [ ]`：勾了不代表填了，GitHub 还渲染成「未完成」'
  else
    ok '无 `- [ ]`'
  fi

  # 4 —— 如实登记：不压段 / 须分条
  local rl rtext nxt i
  if field_line "如实登记"; then
    rl=$FLN
    rtext="${BL[$((rl - 1))]}"
    # ⚠️ 只对「圈号」那条剥代码跨度；结构判据（是否以「：」结尾）必须用原文，
    #    否则 `- **如实登记**：`无`` 这类写法会被剥成只剩冒号，误判成「下无子项」。
    if has_circled "$(strip_code "$rtext")"; then
      bad '如实登记 用 ①②③ 压段：须一条一行（§4.1）'
    fi
    rtext="${rtext%"${rtext##*[![:space:]]}"}"      # 去尾空白
    case "$rtext" in
      *：无) ok '如实登记：无（允许）' ;;
      *：)
        nxt=""
        for ((i = rl; i < ${#BL[@]}; i++)); do
          [ -n "${BL[$i]}" ] || continue
          nxt="${BL[$i]}"
          break
        done
        nxt="${nxt#"${nxt%%[![:space:]]*}"}"        # 去前导空白（子项通常缩进两格）
        case "$nxt" in
          "- "*) : ;;
          *) bad '如实登记 下无子项：一条一行，格式 `  - <事项>`' ;;
        esac
        ;;
      *) bad '如实登记 未以「：」结尾：应写「：」后分条列' ;;
    esac
  fi

  # 5 —— 改动面首行 N / M / K
  local dl dtext
  if field_line "改动面"; then
    dl=$FLN
    dtext="${BL[$((dl - 1))]}"
    [[ "$dtext" =~ 动了[^0-9]{0,3}[0-9]+[^0-9]{0,3}条路径 ]] \
      || bad '改动面 首行缺「动了 N 条路径」（N 须等于 gh pr diff --name-only 的文件数）'
    [[ "$dtext" =~ 归为[^0-9]{0,3}[0-9]+[^0-9]{0,3}项 ]] \
      || bad '改动面 首行缺「归为 M 项」'
    [[ "$dtext" =~ 未动[^0-9]{0,3}[0-9]+[^0-9]{0,3}处 ]] \
      || bad '改动面 首行缺「未动 K 处」'
  fi

  # 6 —— 跨技术栈须列三列表（按真实 diff 判，不认正文自述）
  if [ -z "$diff_base" ]; then
    skip '跨栈表格：未给 --diff-base，无法判（CI 与本地都应给）'
  else
    local files stacks n
    files=$(git diff --name-only "${diff_base}...HEAD" 2>/dev/null | head -500)
    if [ -z "$files" ]; then
      skip "跨栈表格：${diff_base}...HEAD 为空，无法判"
    else
      stacks=$(printf '%s\n' "$files" | awk -F/ 'NF>1 { print $1 }' \
        | sort -u | grep -Ex 'app|server|content|infra' || true)
      n=$(printf '%s\n' "$stacks" | grep -c . || true)
      if [ "${n:-0}" -ge 2 ]; then
        local tb=0
        for l in "${BL[@]}"; do
          case "$l" in "| 模块 | 是否改动 | 说明 |"*) tb=1; break ;; esac
        done
        if [ "$tb" -ne 0 ]; then
          ok "跨 ${n} 个技术栈，已列三列表"
        else
          bad "跨 ${n} 个技术栈（$(printf '%s' "$stacks" | tr '\n' ' ')），缺「模块 / 是否改动 / 说明」三列表（§4.1）"
        fi
      else
        ok "只动了 ${n:-0} 个技术栈目录，不需三列表"
      fi
    fi
  fi

  # 7 —— 反证：须写明未验
  local a b uv=0
  if field_bounds "反证"; then
    a=$FA; b=$FB
    for ((i = a; i < b; i++)); do
      case "${BL[$i]}" in *未验*) uv=1; break ;; esac
    done
    if [ "$uv" -ne 0 ]; then
      ok '反证 已写明「未验」'
    else
      bad '反证 未写明哪些没验（§4.1）'
    fi
  fi

  # 8 —— 变更摘要与三字段的多行条目不得带编号前缀（§4.1 · 2026-10-24）
  local before=$fail
  if section_bounds "## 变更摘要"; then
    scan_num "变更摘要" "$SA" "$SB"
  fi
  for f in "改动面" "反证" "如实登记"; do
    field_bounds "$f" || continue
    scan_num "$f" "$FA" "$FB"
  done
  [ "$fail" -eq "$before" ] && ok '变更摘要与三字段：多行条目无编号前缀'

  if [ "$fail" -ne 0 ]; then
    printf '\npr-body：有违规，改正文后重跑（不必重开 PR）\n'
    return 1
  fi
  printf '\npr-body：全部通过\n'
  return 0
}

self_test() {
  local status=0 dir b1
  dir=$(mktemp -d)
  b1="$dir/good.md"

  cat > "$b1" <<'EOF'
## 变更摘要

一句话总述：为什么要做这件事。

- 做了什么之一：`docs/specs/git-conventions.md` 加一句
- 做了什么之二：`app/tool/docs/rules.dart` 加一条检查

## 自审留痕

- **分支基线**：从 `abc1234` 切出，与 `main` 无分叉
- **改动面**：动了 `1` 条路径，归为 `1` 项；未动 `1` 处
  - 规则：`docs/specs/git-conventions.md` 加一句
  - 未动：`app/` 任何 Dart 代码
- **版号**：不变 —— 活文档不设版号
- **反证**：
  - 假设脚本对压段漏判 → 造一个带圈号的压段正文 → 实测报红
  - **未验**：CI 事件里的 body 是否被截断
- **如实登记**：
  - 只判形态，不判反证实质
  - 正文里**讨论**这条规则时会写 `- [ ]` 与 `②`，两者都在行内代码里，不算违规（负例六守这条）

## 交付物

无

## AI 参与

纯人工

## 关联

[#148](https://github.com/liberalluz/weltuhr-knowledge/pull/148)
EOF

  # 从正例派生负例：**纯 bash**，不用 sed —— Git Bash 每个外部进程约 2 s，
  # 五条 sed 就是 10 s。`derive <目标文件> <原行> <新行>`。
  local l
  derive() {
    : > "$1"
    while IFS= read -r l; do
      if [ "$l" = "$2" ]; then printf '%s\n' "$3" >> "$1"
      else printf '%s\n' "$l" >> "$1"; fi
    done < "$b1"
  }

  # 负例一：如实登记压段（圈号压在同一行）
  derive "$dir/bad1.md" "- **如实登记**：" "- **如实登记**：① 甲；② 乙"
  # 负例二：如实登记条目用阿拉伯序号
  derive "$dir/bad2.md" "  - 只判形态，不判反证实质" "  1. 只判形态"
  # 负例三：反证条目用罗马数字
  derive "$dir/bad3.md" "  - **未验**：CI 事件里的 body 是否被截断" \
    "  ii. 未验：CI 事件里的 body 是否被截断"
  # 负例四：改动面条目用圈号
  derive "$dir/bad4.md" '  - 未动：`app/` 任何 Dart 代码' '  - ② 未动：`app/` 任何 Dart 代码'
  # 负例五：变更摘要的多事项用阿拉伯序号
  derive "$dir/bad5.md" '- 做了什么之一：`docs/specs/git-conventions.md` 加一句' \
    '- 1. 做了什么之一：`docs/specs/git-conventions.md` 加一句'
  # 负例六：真的 task list（不在行内代码里）
  derive "$dir/bad6.md" "纯人工" $'纯人工\n\n- [ ] 未做完'

  printf -- '--- self-test 正例（应 exit 0）---\n'
  fail=0
  if check_body "$b1" "" >/dev/null 2>&1; then
    printf 'ok    [self-test] 正例通过\n'
  else
    printf '[FAIL] [self-test] 正例被误判为违规\n'
    status=1
  fi

  local n=0 nf
  for nf in "$dir/bad1.md" "$dir/bad2.md" "$dir/bad3.md" "$dir/bad4.md" "$dir/bad5.md" "$dir/bad6.md"; do
    n=$((n + 1))
    fail=0
    printf -- '--- self-test 负例 %d（应 exit 1）---\n' "$n"
    if check_body "$nf" "" >/dev/null 2>&1; then
      printf '[FAIL] [self-test] 负例 %d 未被判出（装置失效）\n' "$n"
      status=1
    else
      printf 'ok    [self-test] 负例 %d 被判出\n' "$n"
    fi
  done

  rm -f "$b1" "$dir"/bad*.md 2>/dev/null || true
  rmdir "$dir" 2>/dev/null || true
  return "$status"
}

main() {
  local mode="" file="" diff_base=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --file)      mode="file"; file="${2:-}"; shift 2 ;;
      --stdin)     mode="stdin"; shift ;;
      --diff-base) diff_base="${2:-}"; shift 2 ;;
      --self-test) mode="self"; shift ;;
      -h|--help)   sed -n '2,25p' "$0"; return 0 ;;
      *) printf '未知参数：%s\n' "$1"; return 2 ;;
    esac
  done

  case "$mode" in
    self) self_test; return $? ;;
    file)
      [ -n "$file" ] || { printf '缺 --file 的路径\n'; return 2; }
      [ -f "$file" ] || { printf '文件不存在：%s\n' "$file"; return 2; }
      check_body "$file" "$diff_base"; return $? ;;
    stdin)
      local tmp
      tmp=$(mktemp)
      cat > "$tmp"
      check_body "$tmp" "$diff_base"
      local rc=$?
      rm -f "$tmp"
      return $rc ;;
    *) printf '用法：%s --file <正文.md> [--diff-base <ref>] | --stdin | --self-test\n' "$0"; return 2 ;;
  esac
}

main "$@"
