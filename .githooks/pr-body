#!/usr/bin/env bash
# PR body shape checker — one implementation shared by the local pre-PR run and CI.
#
# The rules are docs/specs/git-conventions.md §4.1 (fourteen checks). This file only
# implements them; it does not restate them, and it does not keep a second copy.
#
# Usage:
#   bash .githooks/pr-body --file <body.md> [--diff-base origin/main]
#   bash .githooks/pr-body --stdin [--diff-base origin/main]
#   bash .githooks/pr-body --self-test
#
# Exit codes: 0 pass · 1 violations · 2 usage error.
#
# ── Implementation notes ──────────────────────────────────────────────
# Why pure bash with mapfile: every external process on Git Bash costs ~0.2–0.5 s
# and the CI budget for this step is ~5 s. Do not put grep/sed back inside loops.
#
# Locator functions write globals (FLN / FA / FB / SA / SB) instead of echoing.
# `x=$(field_line ...)` would fork a subshell per call; the self-test calls the
# locators dozens of times.
#
# Regular expressions must be assigned to a variable before `[[ =~ ]]`: an inline
# `[^)]` is parsed as the closing bracket of the conditional expression.
#
# ── What this checker cannot decide ───────────────────────────────────
# Whether `反证` was written as self-confirmation, whether "one thing vs two
# things" is true, and whether something counts as a controlled config item.
# Those stay human judgements and belong in `如实登记`.

set -u

fail=0
ok()   { printf 'ok    %s\n' "$1"; }
bad()  { printf '[FAIL] %s\n' "$1"; fail=1; }
skip() { printf 'skip  %s\n' "$1"; }

declare -a BL=()

load_body() { mapfile -t BL < "$1"; }

# ── Locators (pure bash) ──────────────────────────────────────────────

# Leading number prefix: circled, roman i./ii., arabic 1. Returns 0 when present.
# The separator plus a space is required so that "3 条" or "2026-10-23" is not
# mistaken for a numbered item.
num_prefix() {
  local s h front sep d
  strip_code "$1"                          # text inside code spans is an example
  s="$SC"
  s="${s#"${s%%[![:space:]]*}"}"           # leading whitespace
  s="${s#- }"; s="${s#\* }"; s="${s#+ }"   # one list marker
  case "$s" in
    '①'*|'②'*|'③'*|'④'*|'⑤'*|'⑥'*|'⑦'*|'⑧'*|'⑨'*|'⑩'*) return 0 ;;
  esac
  h="${s%%[[:space:]]*}"
  sep=""
  for d in . '、' ')' '）'; do
    case "$h" in
      *"$d"*) front="${h%%"$d"*}"; sep=1; break ;;
    esac
  done
  [ -n "$sep" ] || return 1
  case "$front" in
    ''|*[!0-9]*) ;;
    *) [ "${#front}" -le 2 ] && return 0; return 1 ;;
  esac
  case "$front" in
    i|ii|iii|iv|v|vi|I|II|III|IV|V|VI) return 0 ;;
  esac
  return 1
}

has_circled() {
  case "$1" in
    *①*|*②*|*③*|*④*|*⑤*|*⑥*|*⑦*|*⑧*|*⑨*|*⑩*) return 0 ;;
  esac
  return 1
}

# Strip inline code spans (paired backticks), leaving the rest in SC.
# Required: the body legitimately *discusses* `- [ ]` and ①②③ inside code spans,
# and those must not be judged as real tasks or real numbering.
# Writes a global instead of printing: `$(strip_code ...)` would fork a subshell
# per call and has already made the self-test time out once.
strip_code() {
  local s="$1" out=""
  while case "$s" in *'`'*) true ;; *) false ;; esac; do
    out+="${s%%\`*}"
    s="${s#*\`}"
    case "$s" in *'`'*) s="${s#*\`}" ;; *) s="" ;; esac
  done
  SC="$out$s"
}

# Count full-width semicolons (`；`) in a line; result in SEMIS.
count_semis() {
  local s="$1"
  s="${s//[^；]/}"
  SEMIS=${#s}
}

has_section() {  # $1 = exact heading line, e.g. `## 变更摘要`
  local l
  for l in "${BL[@]}"; do
    [ "$l" = "$1" ] && return 0
  done
  return 1
}

FLN=0        # field_line: 1-based line number
FA=0 FB=0    # field_bounds: 0-based [start, end)
SA=0 SB=0    # section_bounds: 0-based [start, end)

field_line() {   # $1 = field name; sets FLN
  local i l
  for ((i = 0; i < ${#BL[@]}; i++)); do
    l="${BL[$i]}"
    case "$l" in
      "- **$1**"*) FLN=$((i + 1)); return 0 ;;
    esac
  done
  return 1
}

# Field block: from the field line to the next field line or `## ` heading.
# `## ` must break too: `如实登记` is the last field of its section and is
# followed by another `##`, otherwise the next sections get swallowed.
field_bounds() {
  local s i l
  field_line "$1" || return 1
  s=$FLN
  for ((i = s; i < ${#BL[@]}; i++)); do
    l="${BL[$i]}"
    case "$l" in "- **"*|"## "*) break ;; esac
  done
  FA=$s; FB=$i
  return 0
}

# Section block: heading line + 1 up to the next `## ` heading.
section_bounds() {
  local i n=${#BL[@]} a=-1 b=-1
  for ((i = 0; i < n; i++)); do
    if [ "$a" -lt 0 ]; then
      [ "${BL[$i]}" = "$1" ] && a=$((i + 1))
      continue
    fi
    case "${BL[$i]}" in "## "*) b=$i; break ;; esac
  done
  [ "$a" -ge 0 ] || return 1
  [ "$b" -lt 0 ] && b=$n
  SA=$a; SB=$b
  return 0
}

section_contains() {  # $1 = heading; $2 = text that must appear inside
  section_bounds "$1" || return 1
  local i
  for ((i = SA; i < SB; i++)); do
    case "${BL[$i]}" in *"$2"*) return 0 ;; esac
  done
  return 1
}

# Strips `- **name**：` from a field line and removes all whitespace; result in FR.
field_value() {  # $1 = field name; requires field_line first
  local l="${BL[$((FLN - 1))]}"
  strip_code "$l"
  l="${SC#- \*\*$1\*\*}"
  l="${l#：}"; l="${l#:}"
  FR="${l//[[:space:]]/}"
  FR="${FR//　/}"
}

# Scans [a, b) for number prefixes; $1 = label; $4=1 also flags "≥2 items on one line".
# A single circled number may be a legitimate quotation of someone else's numbering,
# so the packed-line rule requires a separator right before the number.
scan_num() {
  local i l n=0 c cc
  for ((i = $2; i < $3; i++)); do
    l="${BL[$i]}"
    [ -n "$l" ] || continue
    if num_prefix "$l"; then
      bad "$1 用了编号前缀（应缩进项目符号、一条一行、不加编号）：$l"
      n=$((n + 1))
      continue
    fi
    if [ "${4:-0}" -eq 1 ]; then
      strip_code "$l"
      cc=0
      for c in '①' '②' '③' '④' '⑤' '⑥' '⑦' '⑧' '⑨' '⑩'; do
        case "$SC" in *"：$c"*) cc=$((cc + 1)) ;; esac
        case "$SC" in *"；$c"*) cc=$((cc + 1)) ;; esac
      done
      if [ "$cc" -ge 2 ]; then
        bad "$1 把 ≥2 条压在同一个段落里（应一条一行）：$l"
        n=$((n + 1))
      fi
    fi
  done
  return 0
}

check_body() {
  local body="$1"
  local diff_base="${2:-}"

  load_body "$body"

  local sec f l i

  # 1 — nine sections, exact headings. Order is not judged.
  for sec in "## 变更摘要" "## 影响面" "## 自审留痕" "## 验证" \
             "## UI 证据" "## 交付物" "## AI 参与" "## 关联" "## 评审提示"; do
    has_section "$sec" || bad "缺节：$sec"
  done

  # 2 — five audit fields, plus the base sha must resolve.
  for f in "分支基线" "改动面" "版号" "反证" "如实登记"; do
    field_line "$f" || bad "自审留痕缺字段：$f"
  done
  if field_line "分支基线"; then
    local bline="${BL[$((FLN - 1))]}" bsha
    if [[ $bline =~ ([0-9a-f]{7,40}) ]]; then
      bsha="${BASH_REMATCH[1]}"
      if git cat-file -e "${bsha}^{commit}" 2>/dev/null; then
        ok "分支基线 sha 可解析：${bsha}"
      else
        skip "分支基线 sha ${bsha} 本地对象缺失（未 fetch？），不判红"
      fi
    else
      bad '分支基线缺 7–40 位十六进制 sha'
    fi
  fi

  # 3 — no task list. Inline code is stripped first: the body may discuss `- [ ]`.
  local tl=0
  for l in "${BL[@]}"; do
    strip_code "$l"
    case "$SC" in *"- [ ]"*) tl=1; break ;; esac
  done
  if [ "$tl" -ne 0 ]; then
    bad '出现 `- [ ]`：勾了不代表填了，GitHub 还渲染成「未完成」'
  else
    ok '无 `- [ ]`'
  fi

  # 4 — 如实登记: 0 / 1 / N. Only the zero case may stay inline as `无`.
  if field_line "如实登记"; then
    local rl rtext nxt
    rl=$FLN
    rtext="${BL[$((rl - 1))]}"
    # Strip code spans only for the circled-number check; the structural check
    # must use the original text, or `：无` collapses to a bare colon.
    strip_code "$rtext"
    has_circled "$SC" && bad '如实登记 用 ①②③ 压段：须一条一行（§4.1）'
    field_value "如实登记"
    case "$FR" in
      无|无。) ok '如实登记：无（允许）' ;;
      *)
        nxt=""
        for ((i = rl; i < ${#BL[@]}; i++)); do
          [ -n "${BL[$i]}" ] || continue
          nxt="${BL[$i]}"
          break
        done
        nxt="${nxt#"${nxt%%[![:space:]]*}"}"
        case "$nxt" in
          "- "*) : ;;
          *) bad '如实登记 未分条：须「- **如实登记**：」+ 缩进 `- <一条>`' ;;
        esac
        ;;
    esac
    # One semicolon may join parts of a single item; two or more means items were
    # packed onto one line.
    if field_bounds "如实登记"; then
      local se
      for ((i = FA - 1; i < FB; i++)); do
        se="${BL[$i]}"
        strip_code "$se"
        count_semis "$SC"
        [ "$SEMIS" -ge 2 ] && bad "如实登记 一句里用 ； 串了 ≥2 件（应一条一行）：$se"
      done
    fi
  fi

  # 5 — 改动面: N/M/K header, N reconciled against the real diff, item shape.
  local dl dtext dn=0 dk=-1
  if [ -n "$diff_base" ]; then
    dn=$(git diff --name-only "${diff_base}...HEAD" 2>/dev/null | grep -c . || true)
  fi
  if field_line "改动面"; then
    dl=$FLN
    dtext="${BL[$((dl - 1))]}"
    if [[ "$dtext" =~ 动了[^0-9]{0,3}([0-9]+)[^0-9]{0,3}条路径 ]]; then
      if [ "$dn" -gt 0 ]; then
        if [ "${BASH_REMATCH[1]}" -ne "$dn" ]; then
          bad "改动面 的 N=${BASH_REMATCH[1]} 与真实 diff 的 ${dn} 个文件对不上"
        else
          ok "改动面 N=${BASH_REMATCH[1]} 与真实 diff 一致"
        fi
      else
        skip "改动面 N=${BASH_REMATCH[1]}：${diff_base:-未给}...HEAD 为空或未给，无法对账"
      fi
    else
      bad '改动面 首行缺「动了 N 条路径」（N 须等于 git diff --name-only 的行数）'
    fi
    [[ "$dtext" =~ 归为[^0-9]{0,3}([0-9]+)[^0-9]{0,3}项 ]] || bad '改动面 首行缺「归为 M 项」'
    if [[ "$dtext" =~ 未动[^0-9]{0,3}([0-9]+)[^0-9]{0,3}处 ]]; then
      dk="${BASH_REMATCH[1]}"
    else
      bad '改动面 首行缺「未动 K 处」'
    fi

    # Item shape: `- <做了什么>：<路径与依据>` — the colon must be there, and the
    # text before it must not itself be a path.
    if field_bounds "改动面"; then
      local e part
      for ((i = FA - 1; i < FB; i++)); do
        e="${BL[$i]}"
        e="${e#"${e%%[![:space:]]*}"}"
        case "$e" in "- **"*) continue ;; "- "*) : ;; *) continue ;; esac
        case "$e" in
          *：*) ;;
          *) bad "改动面条目须含全角冒号（做了什么：路径与依据）：$e"; continue ;;
        esac
        part="${e%%：*}"
        case "$part" in
          */*) bad "改动面条目冒号前不得是路径（做了什么要写在前）：$e" ;;
        esac
        case "$e" in
          "- 未动"*)
            [ "$dk" -eq 0 ] && bad "未动 K=0 时不得出现「未动」条目：$e"
            ;;
        esac
      done
    fi
  fi

  # 6 — tech-stack table under 影响面. Structure is always checked; the "是" rows
  # are verified against the real diff when a base is given.
  local files stacks n st found val sv
  if [ -n "$diff_base" ]; then
    files=$(git diff --name-only "${diff_base}...HEAD" 2>/dev/null)
  else
    files=""
  fi
  if field_line "技术栈"; then
    field_value "技术栈"
    [ -z "$FR" ] || bad '技术栈 是组名行，不写值（值全在表里）'
  fi
  local th=0 dr=0
  for l in "${BL[@]}"; do
    [ "$l" = "| 模块 | 是否改动 | 说明 |" ] && th=1
    case "$l" in "| docs |"*) dr=1 ;; esac
  done
  if [ "$dr" -ne 0 ]; then
    bad '技术栈表出现 docs 行：docs 不是技术栈目录'
  fi
  if [ "$th" -ne 0 ]; then
    for st in app server content infra; do
      found=0; val=""
      for l in "${BL[@]}"; do
        case "$l" in
          "| $st |"*)
            found=$((found + 1))
            val="${l#| $st | }"
            val="${val%%|*}"
            val="${val//[[:space:]]/}"
            ;;
        esac
      done
      if [ "$found" -eq 0 ]; then
        bad "技术栈表缺 ${st} 行（四栈是封闭全集）"
        continue
      fi
      [ "$found" -gt 1 ] && bad "技术栈表 ${st} 出现 ${found} 行"
      case "$val" in
        是|否) ;;
        *) bad "技术栈表 ${st} 的「是否改动」只能取 是/否，实得「${val}」" ;;
      esac
      if [ "$val" = "是" ] && [ -n "$files" ]; then
        printf '%s\n' "$files" | grep -q "^${st}/" \
          || bad "技术栈表标 ${st} 为「是」，但本次 diff 里没有 ${st}/ 路径"
      fi
    done
  elif [ -n "$files" ]; then
    stacks=$(printf '%s\n' "$files" | awk -F/ 'NF>1 { print $1 }' \
      | sort -u | grep -Ex 'app|server|content|infra' || true)
    n=$(printf '%s\n' "$stacks" | grep -c . || true)
    [ "${n:-0}" -ge 2 ] && bad "跨 ${n} 个技术栈（$(printf '%s' "$stacks" | tr '\n' ' ')），缺影响面下的技术栈表"
  fi

  # 7 — 反证 must state what was not verified.
  # The field line itself is scanned too: "未验" is often written on it.
  local a b uv=0
  if field_bounds "反证"; then
    a=$((FA - 1)); b=$FB
    for ((i = a; i < b; i++)); do
      case "${BL[$i]}" in *未验*) uv=1; break ;; esac
    done
    if [ "$uv" -ne 0 ]; then
      ok '反证 已写明「未验」'
    else
      bad '反证 未写明哪些没验（§4.1）'
    fi
  fi

  # 8 — no numbering prefixes in the summary or the three multi-line fields.
  local before=$fail
  if section_bounds "## 变更摘要"; then
    scan_num "变更摘要" "$SA" "$SB"
  fi
  for f in "改动面" "反证" "如实登记"; do
    field_bounds "$f" || continue
    scan_num "$f" $((FA - 1)) "$FB" 1
  done
  [ "$fail" -eq "$before" ] && ok '变更摘要与三字段：多行条目无编号前缀'

  # 9 — 反证: two independent attempts must not share a line.
  if field_bounds "反证"; then
    local lt nz=0
    for ((i = FA - 1; i < FB; i++)); do
      lt="${BL[$i]}"
      strip_code "$lt"
      case "$SC" in
        *为推翻*为推翻*)
          bad "反证 把 ≥2 件尝试压在同一个段落里（应一条一行）：$lt"
          nz=$((nz + 1))
          ;;
      esac
    done
    [ "$nz" -eq 0 ] && ok '反证 未见多件尝试压段（单件的「为推翻」不报）'
  fi

  # 10 — field lines carry the field name only, with one documented exception:
  # 反证 may carry a single-sentence summary (no · / ；).
  local fl fr
  for fl in "反证" "如实登记"; do
    field_line "$fl" || continue
    strip_code "${BL[$((FLN - 1))]}"
    field_value "$fl"
    fr="$FR"
    case "$fr" in
      ""|无|无。) ;;
      *)
        if [ "$fl" = "反证" ]; then
          case "$fr" in
            *·*|*/*|*；*) bad '反证 字段行的总述须单句（不含 · / ；），逐条尝试下沉到缩进条目' ;;
          esac
        else
          bad "$fl 的字段行夹带了正文（字段行只写字段名，正文下沉到缩进条目）：$fr"
        fi
        ;;
    esac
  done

  # 11 — every path in the body must belong to this repository, so a reader can
  # open it and `gh pr diff` shows it. Code spans are stripped, so an example
  # inside backticks does not count twice.
  local oi pw rest pwe nx=0 trk
  trk=$(git ls-files 2>/dev/null)
  if [ -n "$trk" ]; then
    for sec in "## 变更摘要" "## 影响面" "## 自审留痕" "## 验证" "## UI 证据" \
               "## 交付物" "## AI 参与" "## 关联" "## 评审提示"; do
      section_bounds "$sec" || continue
      for ((oi = SA; oi < SB; oi++)); do
        rest="${BL[$oi]}"
        while [[ "$rest" =~ ([A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)+\.(md|dart|json|py|ya?ml|txt|pdf|sh|toml|log|csv)) ]]; do
          pw="${BASH_REMATCH[1]}"
          rest="${rest#*"$pw"}"
          pwe="${pw//\\/\\\\}"
          pwe="${pwe//\*/\\*}"
          pwe="${pwe//\?/\\?}"
          case $'\n'"$trk"$'\n' in
            # Exact repository-root path, or a suffix match: a command shown as
            # `cd app && dart run tool/docs/check.dart` is still a repo file.
            *$'\n'"$pwe"$'\n'*|*"/$pwe"$'\n'*) ;;
            *)
              bad "正文提到本仓没有的路径（只写本仓 diff 里能核对的东西）：$pw"
              nx=$((nx + 1))
              ;;
          esac
        done
      done
    done
  fi
  [ "$nx" -eq 0 ] && ok '正文提到的文件都在本仓'

  # 12 — PR / issue numbers must be display links; bare numbers expand into a
  # title block, backticked ones are not links at all.
  local nr=0 rest2
  for l in "${BL[@]}"; do
    case "$l" in
      *'`#'[0-9]*'`'*)
        bad "PR 号被反引号包住，点不动（改成显示链接）：$l"
        nr=$((nr + 1))
        continue
        ;;
    esac
    strip_code "$l"
    rest2="$SC"
    while [[ "$rest2" =~ \[#[0-9]+\]\([^\)]*\) ]]; do
      rest2="${rest2/"${BASH_REMATCH[0]}"/}"
    done
    if [[ "$rest2" =~ (^|[^[:alnum:]_])#[0-9]+ ]]; then
      bad "PR 号写成裸号，页面会把它展开成「标题 + 号」（改成显示链接）：$l"
      nr=$((nr + 1))
    fi
  done
  [ "$nr" -eq 0 ] && ok 'PR 号均为显示链接'

  # 13 — field sets per section, platform group shape, AI level enum.
  local v13=$fail
  for f in "平台" "类型" "兼容与回滚" "技术栈" \
           "命令与输出" "测试设计" \
           "级别"; do
    field_line "$f" || bad "缺字段：$f"
  done
  section_contains "## 验证" "未验" || bad '验证缺「未验」'
  section_contains "## AI 参与" "人核" || bad 'AI 参与缺「人核」'

  # Platform group: either `平台：无` with no children, or no value plus one line
  # per platform in the form `<platform>：已测|未测 —— <...>`.
  if field_line "平台"; then
    local pline pval j item plat seen=" "
    field_value "平台"
    pval="$FR"
    pline="${BL[$((FLN - 1))]}"
    if [ "$pval" = "无" ]; then
      for ((j = FLN; j < ${#BL[@]}; j++)); do
        l="${BL[$j]}"
        case "$l" in "- **"*|"## "*) break ;; esac
        case "$l" in
          *"- "*) bad "平台写「无」时不得挂子项：$l" ;;
        esac
      done
    elif [ -n "$pval" ]; then
      bad "平台 是组名行：有子项时不写值，无平台影响时写「无」"
    else
      local pn=0
      for ((j = FLN; j < ${#BL[@]}; j++)); do
        l="${BL[$j]}"
        case "$l" in "- **"*|"## "*) break ;; esac
        case "$l" in
          "  - "*)
            item="${l#  - }"
            pn=$((pn + 1))
            case "$item" in
              Windows：已测*|Windows：未测*|macOS：已测*|macOS：未测*|iOS：已测*|iOS：未测*) ;;
              *) bad "平台子项须为 <平台>：已测|未测 —— <证据或原因>：$item" ;;
            esac
            plat="${item%%：*}"
            case "$seen" in *" $plat "*) bad "平台重复：${plat}" ;; esac
            seen="${seen}${plat} "
            ;;
        esac
      done
      [ "$pn" -eq 0 ] && bad '平台 无值时必须按平台逐行给出已测/未测；无平台影响写「平台：无」'
    fi
  fi

  # AI level must be one of the five values.
  if field_line "级别"; then
    field_value "级别"
    case "$FR" in
      hint|assist|pair|copilot|auto) ;;
      *) bad "AI 参与 的级别须为 hint / assist / pair / copilot / auto，实得「${FR}」" ;;
    esac
  fi
  [ "$fail" -eq "$v13" ] && ok '字段齐全（影响面四字段 / 验证 / AI / 平台组形态）'

  # 14 — 关联: eight-class closed set, one anchor per line, absent classes omitted.
  if section_bounds "## 关联"; then
    local ne=0 only="" line body2 cat hits r c
    for ((i = SA; i < SB; i++)); do
      l="${BL[$i]}"
      [ -n "$l" ] || continue
      ne=$((ne + 1)); only="$l"
    done
    if [ "$ne" -eq 0 ]; then
      bad '关联 为空：没有锚点写「无」，有锚点逐条一行'
    elif [ "$ne" -eq 1 ]; then
      case "$only" in
        无|无。) ok '关联：无（整节一行，允许）' ;;
        *)
          case "$only" in
            "- "*) ;;
            *) bad "关联 非空行须以「- 」开头：$only" ;;
          esac
          body2="${only#- }"
          cat="${body2%%：*}"
          case "$cat" in
            批次号|里程碑|issue|PR|ADR|规格条|用例|待确认事项) ;;
            *) bad "关联 类别名不在八类内：${cat}" ;;
          esac
          ;;
      esac
    else
      for ((i = SA; i < SB; i++)); do
        l="${BL[$i]}"
        [ -n "$l" ] || continue
        case "$l" in
          "- "*) : ;;
          *) bad "关联 节内非空行须以「- 」开头（类别：锚点）：$l"; continue ;;
        esac
        body2="${l#- }"
        cat="${body2%%：*}"
        case "$cat" in
          批次号|里程碑|issue|PR|ADR|规格条|用例|待确认事项) ;;
          *) bad "关联 类别名不在八类内：${cat}"; continue ;;
        esac
        # Two class names on one line means two anchors were packed together.
        hits=0; r="$body2"
        for c in 批次号 里程碑 issue PR ADR 规格条 用例 待确认事项; do
          while case "$r" in *"${c}："*) true ;; *) false ;; esac; do
            hits=$((hits + 1))
            r="${r#*"${c}："}"
          done
        done
        [ "$hits" -ge 2 ] && bad "关联 一行里出现 ${hits} 个类别名（应一条一行）：$l"
      done
    fi
  fi

  if [ "$fail" -ne 0 ]; then
    printf '\npr-body：有违规，改正文后重跑（不必重开 PR）\n'
    return 1
  fi
  printf '\npr-body：全部通过\n'
  return 0
}

self_test() {
  local status=0 dir b1
  dir=$(mktemp -d)
  b1="$dir/good.md"

  cat > "$b1" <<'EOF'
## 变更摘要

一句话总述：为什么要做这件事。

- 给判据加一条检查：`infra/tool/batch/check.py`
- 补一句规则：`docs/specs/git-conventions.md`

## 影响面

- **平台**：
  - Windows：已测 —— `bash .githooks/pr-body --self-test` 全绿
  - macOS：未测 —— 沙箱不能跑，本人终端验
- **类型**：工具
- **兼容与回滚**：无
- **技术栈**：

| 模块 | 是否改动 | 说明 |
|---|---|---|
| app | 否 | 无 |
| server | 否 | 无 |
| content | 否 | 无 |
| infra | 是 | 改判据脚本 |

## 自审留痕

- **分支基线**：从 `5aa14b1` 切出，与 `main` 无分叉
- **改动面**：动了 `2` 条路径，归为 `2` 项；未动 `0` 处
  - 加一条检查：`infra/tool/batch/check.py`
  - 补一句规则：`docs/specs/git-conventions.md`
- **版号**：不变 —— 活文档不设版号
- **反证**：本笔在推翻「压段只在行首判就够」。
  - 假设圈号在行中间会漏判 → 造一条 `：① 甲；② 乙` → 实测报红
  - **未验**：CI 事件里的 body 是否被截断
- **如实登记**：
  - 只判形态，不判反证实质

## 验证

- **命令与输出**：

  ```text
  bash .githooks/pr-body --self-test
  ```

- **测试设计**：正例 1 条 + 负例 20 条，覆盖压段 / 编号前缀 / 路径越界
- **未验**：无

## UI 证据

无

## 交付物

无

## AI 参与

- **级别**：pair
- **AI 生成**：判据条文与脚本改动
- **人核**：逐行看了 diff，跑了 self-test

## 关联

- 批次号：`C17`
- 规格条：`docs/specs/git-conventions.md` §4.1

## 评审提示

无
EOF

  # Derive negative cases from the positive one in pure bash: one external process
  # per case would cost ~2 s each on Git Bash.
  local l
  derive() {
    : > "$1"
    while IFS= read -r l; do
      if [ "$l" = "$2" ]; then printf '%s\n' "$3" >> "$1"
      else printf '%s\n' "$l" >> "$1"; fi
    done < "$b1"
  }

  # 1 — 如实登记 packed with circled numbers
  derive "$dir/bad1.md" "- **如实登记**：" "- **如实登记**：① 甲；② 乙"
  # 2 — 如实登记 item numbered with arabic
  derive "$dir/bad2.md" "  - 只判形态，不判反证实质" "  1. 只判形态"
  # 3 — 反证 item numbered with roman
  derive "$dir/bad3.md" "  - **未验**：CI 事件里的 body 是否被截断" \
    "  ii. 未验：CI 事件里的 body 是否被截断"
  # 4 — 改动面 item numbered with circled
  derive "$dir/bad4.md" '  - 补一句规则：`docs/specs/git-conventions.md`' \
    '  - ② 补一句规则：`docs/specs/git-conventions.md`'
  # 5 — 变更摘要 item numbered with arabic
  derive "$dir/bad5.md" '- 给判据加一条检查：`infra/tool/batch/check.py`' \
    '- 1. 给判据加一条检查：`infra/tool/batch/check.py`'
  # 6 — real task list outside code spans
  derive "$dir/bad6.md" '- **级别**：pair' $'- **级别**：pair\n\n- [ ] 未做完'
  # 7 — 反证 two attempts packed on one line
  derive "$dir/bad7.md" "- **反证**：本笔在推翻「压段只在行首判就够」。" \
    "- **反证**：为推翻「甲」试了 A；为推翻「乙」试了 B。**未验**：没测丙"
  # 8 — 如实登记 field line carries body text
  derive "$dir/bad8.md" "- **如实登记**：" "- **如实登记**：\`SPEC-PACK-018\` 的路径串未改"
  # 9 — path that is not in this repository
  derive "$dir/bad9.md" '- **人核**：逐行看了 diff，跑了 self-test' \
    $'- **人核**：逐行看了 diff，跑了 self-test\n\n- `docs/nonexistent/file.md` 改了四处'
  # 10 — bare PR number
  derive "$dir/bad10.md" "- 批次号：\`C17\`" "- 批次号：\`C17\` · #164"
  # 11 — backticked PR number
  derive "$dir/bad11.md" "- 批次号：\`C17\`" "- 批次号：\`C17\` · \`#164\`"
  # 12 — 平台 field not bold
  derive "$dir/bad12.md" "- **平台**：" "- 平台："
  # 13 — platform child without 已测/未测
  derive "$dir/bad13.md" "  - macOS：未测 —— 沙箱不能跑，本人终端验" \
    "  - macOS：没跑 —— 沙箱不能跑，本人终端验"
  # 14 — missing 验证 section entirely
  derive "$dir/bad14.md" '## 验证' '## 验证（缺）'
  # 15 — AI level outside the enum
  derive "$dir/bad15.md" "- **级别**：pair" "- **级别**：特级"
  # 16 — 改动面 item is a bare path (no colon, path first)
  derive "$dir/bad16.md" '  - 补一句规则：`docs/specs/git-conventions.md`' \
    '  - `docs/specs/git-conventions.md`'
  # 17 — K=0 but a 未动 item is present
  derive "$dir/bad17.md" '  - 补一句规则：`docs/specs/git-conventions.md`' \
    $'  - 补一句规则：`docs/specs/git-conventions.md`\n  - 未动：`app/` 任何 Dart 代码'
  # 18 — 关联 packs two classes on one line
  derive "$dir/bad18.md" "- 批次号：\`C17\`" "- 批次号：\`C17\` · ADR：\`ADR-0005\`"
  # 19 — 关联 line without the `- ` marker
  derive "$dir/bad19.md" "- 批次号：\`C17\`" "批次号：\`C17\`"
  # 20 — base sha is not 7–40 hex chars
  derive "$dir/bad20.md" "- **分支基线**：从 \`5aa14b1\` 切出，与 \`main\` 无分叉" \
    "- **分支基线**：从 \`abc12\` 切出，与 \`main\` 无分叉"

  printf -- '--- self-test positive (expect exit 0) ---\n'
  fail=0
  if check_body "$b1" "" >/dev/null 2>&1; then
    printf 'ok    [self-test] 正例通过\n'
  else
    printf '[FAIL] [self-test] 正例被误判为违规\n'
    status=1
  fi

  local n=0 nf
  for nf in "$dir"/bad1.md "$dir"/bad2.md "$dir"/bad3.md "$dir"/bad4.md \
            "$dir"/bad5.md "$dir"/bad6.md "$dir"/bad7.md "$dir"/bad8.md \
            "$dir"/bad9.md "$dir"/bad10.md "$dir"/bad11.md "$dir"/bad12.md \
            "$dir"/bad13.md "$dir"/bad14.md "$dir"/bad15.md "$dir"/bad16.md \
            "$dir"/bad17.md "$dir"/bad18.md "$dir"/bad19.md "$dir"/bad20.md; do
    n=$((n + 1))
    fail=0
    printf -- '--- self-test negative %d (expect exit 1) ---\n' "$n"
    if check_body "$nf" "" >/dev/null 2>&1; then
      printf '[FAIL] [self-test] 负例 %d 未被判出（装置失效）\n' "$n"
      status=1
    else
      printf 'ok    [self-test] 负例 %d 被判出\n' "$n"
    fi
  done

  rm -f "$b1" "$dir"/bad*.md 2>/dev/null || true
  rmdir "$dir" 2>/dev/null || true
  return "$status"
}

main() {
  local mode="" file="" diff_base=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --file)      mode="file"; file="${2:-}"; shift 2 ;;
      --stdin)     mode="stdin"; shift ;;
      --diff-base) diff_base="${2:-}"; shift 2 ;;
      --self-test) mode="self"; shift ;;
      -h|--help)   sed -n '2,28p' "$0"; return 0 ;;
      *) printf '未知参数：%s\n' "$1"; return 2 ;;
    esac
  done

  case "$mode" in
    self) self_test; return $? ;;
    file)
      [ -n "$file" ] || { printf '缺 --file 的路径\n'; return 2; }
      [ -f "$file" ] || { printf '文件不存在：%s\n' "$file"; return 2; }
      check_body "$file" "$diff_base"; return $? ;;
    stdin)
      local tmp
      tmp=$(mktemp)
      cat > "$tmp"
      check_body "$tmp" "$diff_base"
      local rc=$?
      rm -f "$tmp"
      return $rc ;;
    *) printf '用法：%s --file <正文.md> [--diff-base <ref>] | --stdin | --self-test\n' "$0"; return 2 ;;
  esac
}

main "$@"
