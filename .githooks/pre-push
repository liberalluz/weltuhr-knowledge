#!/usr/bin/env bash
# Commits pushed to main must carry a PR number -- one file shared by the local
# hook and CI.
#
# Criteria come from docs/specs/git-conventions.md:
#   §二 / §4.1 -- main only accepts PR merges; the sole exception is the
#                 repository's initial commit.
#   §2.2       -- a non-main branch needs an active batch, and the pushed paths
#                 must fall inside that batch's scope.
#
# -- Why key on "(#NNN)" instead of rejecting every push to main -------------
# `(#NNN)` is not a field of the commit object; it is plain text written into
# the title by the platform during a squash merge -- only commits that went
# through a PR have it. So "every commit about to be pushed carries a number"
# is equivalent to "these commits came from PR merges", and it also lets two
# legitimate cases through:
#   - local main is in sync with the remote (empty range, nothing to push)
#   - repository's initial commit (new branch, remote sha all zeros)
#
# The alternative, "reject anything targeting main", blocks both legitimate
# cases; adding exceptions for them means checking "is this the initial commit"
# again -- one more layer of criteria. Keying on the number also pins §3.4's
# trace rule: after a merge the title keeps (#PR).
#
# Usage:
#   .githooks/pre-push                        # git hook (refs on stdin)
#   .githooks/pre-push --range <rev-range>    # CI (per commit)
#
# Exit codes: 0 pass, 1 violation.
#
# -- Why both ends share this one file ---------------------------------------
# Same shape as commit-msg: splitting it has a concrete cost -- local passes,
# CI fails, people edit CI instead of the process; CI passes, local fails,
# people reach for `--no-verify`. Two copies of a criterion mean no criterion.
#
# -- Second gate: non-branch refs -------------------------------------------
# Only `refs/heads/*` and canonically named tags are pushable. Criterion is §五:
# a tag has exactly two shapes -- product version `vX.Y.Z` (shared by `app/`
# and `server/`) and content pack `pack/<space>/vX.Y.Z`.
#
# Why not "reject every tag": §五 explicitly requires tagging on release
# ("tagging is a public promise"), so a blanket rejection also blocks real work.
# Hence a naming allowlist: canonical shapes pass, everything else (backup /
# scratch markers / `backup/*` and friends) is rejected.
#
# Why deletions pass: a mis-pushed tag must be recoverable. Rejecting deletion
# locks the cleanup action too, and people just add `--no-verify`.
#
# This gate has NO counterpart in CI: `repo-hygiene`'s `on.push` only covers
# `branches: [main]`, so pushing a tag triggers no workflow at all. This one
# exists only near the developer -- which is exactly why it must be cheap.

set -u

FAIL=0
# Two failure classes are tracked apart: if a rejected tag also printed "the
# commit must be a PR artifact", people would go inspect commit messages --
# an error message pointing at the wrong place costs more than no message.
FAIL_MAIN=0
FAIL_REF=0

mark_main() { FAIL=1; FAIL_MAIN=1; }
mark_ref() { FAIL=1; FAIL_REF=1; }

# WARNING: put regexes in variables first. An inline `[^)]` inside
# `[[ s =~ ... ]]` is parsed as the closing paren of the conditional and bash
# dies with `syntax error ... unexpected token )` -- same trap as commit-msg.
TAG_RE='\(#[0-9]+\)'
ZERO_RE='^0+$'

# The two tag shapes of §五. `space` is `KnowledgeSpace.id`, so the character
# class is narrowed to an id's alphabet (alnum plus `._-`) and the `/` inside
# `<space>` is deliberately not honoured -- a greedy `pack/*/v*` would also let
# the illegal `pack/a/b/v1.0.0` through.
SEMVER_RE='v[0-9]+\.[0-9]+\.[0-9]+'
TAG_OK_RE="^refs/tags/(${SEMVER_RE}|pack/[A-Za-z0-9._-]+/${SEMVER_RE})$"

check_range() {
  local range=$1
  local n=0 line sha subject ok

  if [ -z "$range" ]; then
    echo 'pre-push: 区间为空（本地与远端一致），跳过'
    return 0
  fi

  # On a branch's first push GitHub sends an all-zero `before`, so the range
  # becomes `0000...0000..<sha>`. rev-list fails on that, and the error has
  # nothing to do with "did this go through a PR" -- degrade to "check this one
  # commit" here instead of going red on a misleading error.
  case "$range" in
    *0000000000000000000000000000000000000000*)
      range="-n 1 ${range##*..}"
      ;;
  esac

  # Fetch every title in ONE call. Looping `git log -1` costs ~100 ms per commit
  # on Windows; a hundred-commit range takes tens of seconds, while this check
  # is budgeted at "cheaper than check-ignore".
  local log
  # shellcheck disable=SC2086
  if ! log=$(git log --format='%h%x09%s' $range 2>/dev/null); then
    echo "FAIL 无法解析区间 \`$range\`（base 是否已 fetch？fetch-depth 是否够？）" >&2
    mark_main
    return 1
  fi
  if [ -z "$log" ]; then
    echo 'pre-push: 区间内无提交，跳过'
    return 0
  fi

  while IFS=$'\t' read -r sha subject; do
    [ -z "$sha" ] && continue
    n=$((n + 1))
    if [[ $subject =~ $TAG_RE ]]; then
      continue
    fi
    echo "FAIL $sha: 无 PR 编号 —— $subject" >&2
    mark_main
  done <<<"$log"

  echo "pre-push: 校验 ${n} 条"
}

# -- Third gate: non-fast-forward pushes ------------------------------------
# The gate above only reads titles, so it cannot stop `git commit --amend` plus
# a force push -- the commit still carries `(#NNN)` while the commit that was on
# the remote got replaced. The number is there, the history is not: once the sha
# changes, the PR record, CI verdicts and everyone's clone no longer line up,
# and none of that is visible in `git log` on main. This gate keys on ancestry,
# independent of titles.
#
# Why "object missing locally" is rejected rather than allowed: without a fetch
# ancestry cannot be decided, and guessing "probably a fast-forward" is not
# warranted. Allowing a wrong guess risks rewriting published history; rejecting
# costs one `git fetch`. The costs are asymmetric, so follow the asymmetry.
check_fast_forward() {
  local before=$1 after=$2

  # The remote has no such ref yet (first push / new branch): no history to rewrite
  if [[ $before =~ $ZERO_RE ]]; then
    return 0
  fi

  if ! git cat-file -e "${before}^{commit}" 2>/dev/null; then
    echo "FAIL 本地没有远端 main 的提交 \`$before\` —— 先 \`git fetch origin\` 再重试" >&2
    mark_main
    return 1
  fi

  if git merge-base --is-ancestor "$before" "$after" 2>/dev/null; then
    return 0
  fi

  echo "FAIL 非快进推送 —— 远端 \`${before:0:7}\` 不是 \`${after:0:7}\` 的祖先（§4.3 Allow force pushes ❌）" >&2
  echo '     这次推送会删掉远端已有的提交，等于改写已发布的历史。' >&2
  echo '     要改已合入的提交信息：开新 PR，不要 amend 后强推。' >&2
  echo '     已合 PR 的正文或标题用 `gh pr edit` 改，那不会动提交。' >&2
  mark_main
  return 1
}

# Tag gate: deletions pass, canonical names pass, everything else is rejected.
check_tag() {
  local ref=$1 sha=$2 name=${1#refs/tags/}

  if [[ $sha =~ $ZERO_RE ]]; then
    echo "pre-push: 放行删除远端 tag \`$name\`"
    return 0
  fi

  if [[ $ref =~ $TAG_OK_RE ]]; then
    echo "pre-push: 放行 tag \`$name\`（§五 命名）"
    return 0
  fi

  echo "FAIL 不允许推送 tag \`$name\`" >&2
  echo "     只接受 §五 两种命名：\`vX.Y.Z\` · \`pack/<space>/vX.Y.Z\`。" >&2
  echo "     备份 / 临时标记类 tag 只留本地，不上远端。" >&2
  mark_ref
  return 1
}

mode=${1:-}
PUSHED_BRANCH=0
if [ "$mode" = '--range' ]; then
  check_range "${2:-}"
else
  # The git hook feeds four fields per stdin line:
  # <local-ref> <local-sha> <remote-ref> <remote-sha>
  # When deleting a remote branch, local-ref is `(delete)` and local-sha is all zeros.
  while read -r local_ref local_sha remote_ref remote_sha; do
    # Classify the ref type before talking about main -- the two gates must not
    # cover each other: a tag must not fall into a silent "not main, continue"
    # branch (the earlier version did exactly that, so backup tags went
    # straight through).
    case "$remote_ref" in
      refs/heads/*) ;;
      refs/tags/*)
        check_tag "$remote_ref" "$local_sha"
        continue
        ;;
      *)
        echo "FAIL 不允许推送非分支引用 \`$remote_ref\`（只允许 refs/heads/* 与 §五 命名的 tag）" >&2
        mark_ref
        continue
        ;;
    esac

    case "$remote_ref" in
      refs/heads/main) ;;
      *)
        # A real update of a non-main branch (not a deletion) needs an active batch.
        if [[ ! $local_sha =~ $ZERO_RE ]]; then
          PUSHED_BRANCH=1
        fi
        continue
        ;;
    esac

    if [[ $local_sha =~ $ZERO_RE ]]; then
      echo 'FAIL 不允许删除 main（§4.3 Allow deletions ❌）' >&2
      mark_main
      continue
    fi

    if [[ $remote_sha =~ $ZERO_RE ]]; then
      # The remote has no main yet -- only possible on the initial commit (§二's sole exception)
      echo 'pre-push: 远端 main 尚不存在，按初始化首提放行'
      continue
    fi

    # Check ancestry before the title: in a rewritten push the title may still
    # carry the number, and the reverse order would first accept the title and
    # then explain something unrelated to it.
    check_fast_forward "$remote_sha" "$local_sha" || continue

    check_range "$remote_sha..$local_sha"
  done
fi

# -- Fourth gate: scope guard for the active batch --------------------------
# A real push of a non-main branch requires an active batch; without one this
# fails closed instead of silently skipping. Branch deletions, tags and
# `--range` replays are out of scope. --quick compares paths only, no tests.
if [ "$mode" != '--range' ] && [ "$PUSHED_BRANCH" -eq 1 ]; then
  if [ ! -f .batch/active ]; then
    echo '' >&2
    echo 'FAIL 没有 .batch/active：不知道本分支的 approved scope，pre-push 拒绝。' >&2
    echo '先建批次：' >&2
    echo '  python3 infra/tool/batch/batch.py plan --auto-id --type <process|feat> ...' >&2
    echo '  python3 infra/tool/batch/batch.py approve <id> --chat --confirm <hash8>' >&2
    echo '  python3 infra/tool/batch/batch.py start <id>' >&2
    echo '明确绕过（仅在你知道风险时）：git push --no-verify' >&2
    exit 1
  fi

  scope="$(cat .batch/active)"
  if [ -z "$scope" ]; then
    echo 'FAIL .batch/active 为空：先 batch start <id>' >&2
    exit 1
  fi

  py=python3
  command -v python3 >/dev/null 2>&1 || py=python
  if ! "$py" infra/tool/batch/check.py --scope "$scope" --quick; then
    echo '' >&2
    echo 'FAIL batch scope guard：改动超出 scope.json。' >&2
    echo '扩范围走：python3 infra/tool/batch/check.py --scope <scope> --add <path> --reason <...> --yes' >&2
    echo '并让人类确认后提交 scope 变更；不要直接改 allowed。' >&2
    exit 1
  fi
fi

if [ "$FAIL" -ne 0 ]; then
  echo '' >&2
  if [ "$FAIL_MAIN" -ne 0 ]; then
    echo '推 main 的提交必须是 PR squash 合并的产物（标题带 `(#PR号)`）。' >&2
    echo '走法：batch.py plan → approve → start → 改 → commit → push → batch.py pr → batch.py merge' >&2
    echo '判据出处：docs/specs/git-conventions.md §2.2 / §二 / §3.4 / §4.1。' >&2
  fi
  if [ "$FAIL_REF" -ne 0 ]; then
    echo '远端只收分支与 §五 命名的 tag；其余引用类型一律不推。' >&2
    echo '判据出处：docs/specs/git-conventions.md §五 / §3.5。' >&2
  fi
  exit 1
fi
exit 0
