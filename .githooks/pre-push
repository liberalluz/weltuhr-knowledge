#!/usr/bin/env bash
# 推到 main 的提交必须带 PR 编号 —— 本地 hook 与 CI **共用同一份逻辑**。
#
# 判据取 docs/specs/git-conventions.md §二 / §4.1：
#   `main` 只接受 PR 合入；唯一例外 = 仓库初始化首提。
#
# ── 为什么判「带 (#NNN)」而不是「拒绝一切 push main」────────────────
# `(#NNN)` 不是提交对象上的字段，而是 squash 合并时由平台写进标题的**纯文本** ——
# 只有经过 PR 的提交才有。于是「本次要推上去的每个提交都带编号」与「这些提交来自
# PR 合并」等价，而它同时放行两种合法情形：
#   · 本地 main 与远端同步（区间为空，无提交可推）
#   · 仓库初始化首提（新建分支，远端 sha 为全 0）
#
# 另一条路是「发现目标是 main 就一律拒绝」，但它会把上面两种合法情形一起挡掉，
# 而补例外又得再判一次「是不是首提」—— 判据反而多出一层。取编号，同时也顺手
# 锁住了 §3.4「合入后标题保留 (#PR号)」那条落痕纪律。
#
# 用法：
#   .githooks/pre-push                         # git hook（从 stdin 读 refs）
#   .githooks/pre-push --range <rev-range>     # CI（逐条）
#
# 退出码：0 通过 · 1 有违规。
#
# ── 为什么两端共用同一个文件 ────────────────────────────────────────
# 与 commit-msg 同形：分两份的后果很具体 —— 本地放行、CI 红，人会去改 CI 而不是
# 改流程；反过来 CI 放行、本地红，人会 `--no-verify`。判据一旦有两份，就等于没有。
#
# ── 第二条：非分支引用 ─────────────────────────────────────────────
# 只允许推 `refs/heads/*` 与**规范命名**的 tag。判据取 §五：tag 有且只有两种形态 ——
# 产品版本 `vX.Y.Z`（`app/` 与 `server/` 共用）、内容包 `pack/<space>/vX.Y.Z`。
#
# 为什么不是「一律拒 tag」：§五 明文要求发布时打 tag（「打 tag 即对外承诺」），
# 一律拒会把正事也挡掉。所以取**命名白名单**：规范内的形态放行，其余（备份 /
# 临时标记 / `backup/*` 之类）拒。
#
# 为什么删除放行：误推的 tag 必须能回收。拒删除等于把清理动作也锁死，人只会去
# 加 `--no-verify`。
#
# 本判据在 CI 侧**没有对应步骤**：`repo-hygiene` 的 `on.push` 只挂 `branches: [main]`，
# 推 tag 不触发任何 workflow。这条只有近端一道 —— 也正因如此，它必须便宜。

set -u

FAIL=0
# 两类失败分开记：tag 被拒时若还打印「提交必须是 PR 产物」，人会去查提交信息 ——
# 错误信息指向错的地方，比没有信息更费时间。
FAIL_MAIN=0
FAIL_REF=0

mark_main() { FAIL=1; FAIL_MAIN=1; }
mark_ref() { FAIL=1; FAIL_REF=1; }

# ⚠️ 正则放进变量再用。`[[ s =~ ... ]]` 里内联的 `[^)]` 会被 bash 当成条件表达式
# 的右括号来解析，报 `syntax error ... unexpected token )` —— 与 commit-msg 同一个坑。
TAG_RE='\(#[0-9]+\)'
ZERO_RE='^0+$'

# §五 的两种 tag 形态。`space` 取 `KnowledgeSpace.id`，故按 id 的字符集收窄
# （字母数字与 `._-`），并**不用** `<space>` 里的 `/` 做多段 —— `pack/*/v*` 若写成
# 贪婪匹配，`pack/a/b/v1.0.0` 这种非法规格也会过。
SEMVER_RE='v[0-9]+\.[0-9]+\.[0-9]+'
TAG_OK_RE="^refs/tags/(${SEMVER_RE}|pack/[A-Za-z0-9._-]+/${SEMVER_RE})$"

check_range() {
  local range=$1
  local n=0 line sha subject ok

  if [ -z "$range" ]; then
    echo 'pre-push: 区间为空（本地与远端一致），跳过'
    return 0
  fi

  # GitHub 在新分支首推时把 `before` 给成全 0，区间会变成 `0000…0000..<sha>`。
  # 这种区间 rev-list 报错，而错误信息与「有没走 PR」毫无关系 —— 在这里退化成
  # 「只看这一条」，不让判据红在一条误导性的错误上。
  case "$range" in
    *0000000000000000000000000000000000000000*)
      range="-n 1 ${range##*..}"
      ;;
  esac

  # 所有标题**一次取出**。逐条 `git log -1` 在 Windows 上每条约 100 ms；一个
  # 百条提交的区间要跑十几秒，而这条判据的定位是「比 check-ignore 还便宜」。
  local log
  # shellcheck disable=SC2086
  if ! log=$(git log --format='%h%x09%s' $range 2>/dev/null); then
    echo "FAIL 无法解析区间 \`$range\`（base 是否已 fetch？fetch-depth 是否够？）" >&2
    mark_main
    return 1
  fi
  if [ -z "$log" ]; then
    echo 'pre-push: 区间内无提交，跳过'
    return 0
  fi

  while IFS=$'\t' read -r sha subject; do
    [ -z "$sha" ] && continue
    n=$((n + 1))
    if [[ $subject =~ $TAG_RE ]]; then
      continue
    fi
    echo "FAIL $sha: 无 PR 编号 —— $subject" >&2
    mark_main
  done <<<"$log"

  echo "pre-push: 校验 ${n} 条"
}

# ── 第三条：非快进推送 ─────────────────────────────────────────────
# 上面那条判据只看标题，挡不住 `git commit --amend` 改完标题再强推 ——
# 提交仍带 `(#NNN)`，而远端原有的提交被换掉了。号在、历史已不是原来那条：
# sha 一变，PR 记录、CI 结论、别人已 clone 的分支全部对不上，且从 `main`
# 的 `git log` 上**看不出来**。判据取祖先关系，与标题无关。
#
# 为什么拒绝「对象不在本地」而不是放行：没 fetch 时既判不了祖先，也不该
# 猜「大概是快进」。放行猜错的代价是可能真的改写掉已发布历史，拒掉的代价
# 只是多跑一次 `git fetch`。两个代价不对称，就按不对称的来。
check_fast_forward() {
  local before=$1 after=$2

  # 远端还没有这个引用（首推 / 新分支）：没有历史可改写。
  if [[ $before =~ $ZERO_RE ]]; then
    return 0
  fi

  if ! git cat-file -e "${before}^{commit}" 2>/dev/null; then
    echo "FAIL 本地没有远端 main 的提交 \`$before\` —— 先 \`git fetch origin\` 再重试" >&2
    mark_main
    return 1
  fi

  if git merge-base --is-ancestor "$before" "$after" 2>/dev/null; then
    return 0
  fi

  echo "FAIL 非快进推送 —— 远端 \`${before:0:7}\` 不是 \`${after:0:7}\` 的祖先（§4.3 Allow force pushes ❌）" >&2
  echo '     这次推送会删掉远端已有的提交，等于改写已发布的历史。' >&2
  echo '     要改已合入的提交信息：开新 PR，不要 amend 后强推。' >&2
  echo '     已合 PR 的正文或标题用 `gh pr edit` 改，那不会动提交。' >&2
  mark_main
  return 1
}

# tag 判据。删除放行、规范命名放行、其余拒。
check_tag() {
  local ref=$1 sha=$2 name=${1#refs/tags/}

  if [[ $sha =~ $ZERO_RE ]]; then
    echo "pre-push: 放行删除远端 tag \`$name\`"
    return 0
  fi

  if [[ $ref =~ $TAG_OK_RE ]]; then
    echo "pre-push: 放行 tag \`$name\`（§五 命名）"
    return 0
  fi

  echo "FAIL 不允许推送 tag \`$name\`" >&2
  echo "     只接受 §五 两种命名：\`vX.Y.Z\` · \`pack/<space>/vX.Y.Z\`。" >&2
  echo "     备份 / 临时标记类 tag 只留本地，不上远端。" >&2
  mark_ref
  return 1
}

mode=${1:-}
PUSHED_BRANCH=0
if [ "$mode" = '--range' ]; then
  check_range "${2:-}"
else
  # git hook 的 stdin 每行四段：<local-ref> <local-sha> <remote-ref> <remote-sha>
  # 删除远端分支时 local-ref 是 `(delete)`、local-sha 为全 0。
  while read -r local_ref local_sha remote_ref remote_sha; do
    # 先分引用类型，再谈 main —— 两条判据互不覆盖：tag 不该掉进「不是 main 就 continue」
    # 的静默分支（原写法正是如此，所以备份 tag 会一路推上去）。
    case "$remote_ref" in
      refs/heads/*) ;;
      refs/tags/*)
        check_tag "$remote_ref" "$local_sha"
        continue
        ;;
      *)
        echo "FAIL 不允许推送非分支引用 \`$remote_ref\`（只允许 refs/heads/* 与 §五 命名的 tag）" >&2
        mark_ref
        continue
        ;;
    esac

    case "$remote_ref" in
      refs/heads/main) ;;
      *)
        # 非 main 分支的真实更新（不是删除）需要 active batch。
        if [[ ! $local_sha =~ $ZERO_RE ]]; then
          PUSHED_BRANCH=1
        fi
        continue
        ;;
    esac

    if [[ $local_sha =~ $ZERO_RE ]]; then
      echo 'FAIL 不允许删除 main（§4.3 Allow deletions ❌）' >&2
      mark_main
      continue
    fi

    if [[ $remote_sha =~ $ZERO_RE ]]; then
      # 远端还没有 main —— 只可能是仓库初始化首提（§二 唯一例外）。
      echo 'pre-push: 远端 main 尚不存在，按初始化首提放行'
      continue
    fi

    # 先判祖先关系，再判标题：被改写的推送里标题可能照样带号，顺序反了会先
    # 放过标题、再去解释一件与标题无关的事。
    check_fast_forward "$remote_sha" "$local_sha" || continue

    check_range "$remote_sha..$local_sha"
  done
fi

# ── 第三条：当前 batch 的 scope guard ───────────────────────────────
# 非 main 分支的真实推送必须有 active batch；没有就 fail-closed，不再静默跳过。
# 删除分支、tag、`--range` 回放不在此列。--quick 只比路径，不跑测试。
if [ "$mode" != '--range' ] && [ "$PUSHED_BRANCH" -eq 1 ]; then
  if [ ! -f .batch/active ]; then
    echo '' >&2
    echo 'FAIL 没有 .batch/active：不知道本分支的 approved scope，pre-push 拒绝。' >&2
    echo '先建批次：' >&2
    echo '  python3 infra/tool/batch/batch.py plan <id> --type <process|feat> ...' >&2
    echo '  python3 infra/tool/batch/batch.py approve <id> --chat --confirm <hash8>' >&2
    echo '  python3 infra/tool/batch/batch.py start <id>' >&2
    echo '明确绕过（仅在你知道风险时）：git push --no-verify' >&2
    exit 1
  fi

  scope="$(cat .batch/active)"
  if [ -z "$scope" ]; then
    echo 'FAIL .batch/active 为空：先 batch start <id>' >&2
    exit 1
  fi

  py=python3
  command -v python3 >/dev/null 2>&1 || py=python
  if ! "$py" infra/tool/batch/check.py --scope "$scope" --quick; then
    echo '' >&2
    echo 'FAIL batch scope guard：改动超出 scope.json。' >&2
    echo '扩范围走：python3 infra/tool/batch/check.py --scope <scope> --add <path> --reason <...> --yes' >&2
    echo '并让人类确认后提交 scope 变更；不要直接改 allowed。' >&2
    exit 1
  fi
fi

if [ "$FAIL" -ne 0 ]; then
  echo '' >&2
  if [ "$FAIL_MAIN" -ne 0 ]; then
    echo '推 main 的提交必须是 PR squash 合并的产物（标题带 `(#PR号)`）。' >&2
    echo '走法：git switch -c <type>/<topic> → commit → git push origin <branch> →' >&2
    echo '      gh pr create → gh pr merge --squash --delete-branch' >&2
    echo '判据出处：docs/specs/git-conventions.md §二 / §3.4 / §4.1。' >&2
  fi
  if [ "$FAIL_REF" -ne 0 ]; then
    echo '远端只收分支与 §五 命名的 tag；其余引用类型一律不推。' >&2
    echo '判据出处：docs/specs/git-conventions.md §五 / §3.5。' >&2
  fi
  exit 1
fi
exit 0
