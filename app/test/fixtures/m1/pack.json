  "entries": [
    {
      "node_id": "m1-demo:var",
      "summary": "把名字绑到值上，并在需要时重新绑定。",
      "outcomes": ["能说明赋值语句做了什么", "能区分名字与对象"],
      "resources": [
        {
          "kind": "规范",
          "title": "The Python Tutorial §7.2",
          "url": "https://docs.python.org/3/tutorial/introduction.html",
          "license": "PSF-2.0",
          "lang": "en"
        }
      ],
      "aliases": [],
      "keywords": ["assignment", "binding"],
      "body": "赋值语句把名字重新绑定到值。名字不是容器，只是指向对象；因此修改对象会让所有指向它的名字都看到变化。",
      "steps": [
        {
          "operator": "read",
          "instruction": "读完 §7.2，留意「重新绑定」这个词。",
          "phase": "first"
        },
        {
          "operator": "recall",
          "instruction": "不看材料，说出名字与对象的关系。",
          "phase": "both"
        }
      ],
      "selfCheck": ["能说出名字不是容器"],
      "criteria": [
        {
          "id": "c1",
          "statement": "能独立解释 `a = [1]; b = a; b.append(2)` 之后为什么 `a` 也变成 `[1, 2]`"
        }
      ],
      "quiz": [
        {
          "id": "q1",
          "criterion_id": "c1",
          "type": "choice",
          "prompt": "`a = [1]; b = a; b.append(2)` 之后 `a` 的值是？",
          "answer": "[1, 2]",
          "judge": "auto"
        }
      ],
      "estMinutes": 12,
      "methodId": null
    },
    {
      "node_id": "m1-demo:func",
      "summary": "把一段逻辑收成可复用的、带名字的调用单元。",
      "outcomes": ["能定义并调用一个函数", "能说明参数与返回值的传递"],
      "resources": [
        {
          "kind": "规范",
          "title": "The Python Tutorial §4.8",
          "url": "https://docs.python.org/3/tutorial/controlflow.html#defining-functions",
          "license": "PSF-2.0",
          "lang": "en"
        }
      ],
      "aliases": [],
      "keywords": ["function", "argument"],
      "body": "`def` 创建一个函数对象并绑定名字；调用时实参绑定到形参，返回值由 `return` 给出。",
      "steps": [
        {
          "operator": "example",
          "instruction": "看 §4.8 的 `fib` 例子，标出形参与实参。",
          "phase": "first"
        },
        {
          "operator": "practice",
          "instruction": "写一个把列表元素加倍的函数并调用它。",
          "phase": "both"
        },
        {
          "operator": "explain",
          "instruction": "向别人解释参数是怎么传进函数的。",
          "phase": "both"
        }
      ],
      "selfCheck": ["能说清形参与实参的对应"],
      "criteria": [
        {
          "id": "c1",
          "statement": "能独立写出一个带返回值、并至少有一个参数的函数，且说明调用时的绑定过程"
        }
      ],
      "quiz": [
        {
          "id": "q1",
          "criterion_id": "c1",
          "type": "choice",
          "prompt": "`def f(x): return x * 2` 之后调用 `f(3)` 得到？",
          "answer": "6",
          "judge": "auto"
        }
      ],
      "estMinutes": 15,
      "methodId": null
    }
  ],
  "sources": [
    {
      "id": "m1-tutorial",
