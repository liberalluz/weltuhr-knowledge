  "entries": [
    {
      "node_id": "m2-demo:var",
      "summary": "把名字绑到值上，并在需要时重新绑定。",
      "outcomes": ["能说明赋值语句做了什么", "能区分名字与对象"],
      "resources": [
        {
          "kind": "规范",
          "title": "The Python Tutorial §7.2",
          "url": "https://docs.python.org/3/tutorial/introduction.html",
          "license": "PSF-2.0",
          "lang": "en"
        }
      ],
      "aliases": ["变量"],
      "keywords": ["assignment", "binding"],
      "body": "赋值语句把名字重新绑定到值。名字不是容器，只是指向对象。",
      "steps": [
        { "operator": "read", "instruction": "读完 §7.2，留意「重新绑定」这个词。", "phase": "first" },
        { "operator": "recall", "instruction": "不看材料，说出名字与对象的关系。", "phase": "both" }
      ],
      "selfCheck": ["能说出名字不是容器"],
      "criteria": [{ "id": "c1", "statement": "能独立解释重新绑定后两个名字为何看到同一份修改" }],
      "quiz": [
        {
          "id": "q1",
          "criterion_id": "c1",
          "type": "choice",
          "prompt": "`a = [1]; b = a; b.append(2)` 之后 `a` 的值是？",
          "answer": "[1, 2]",
          "judge": "auto"
        }
      ],
      "source_refs": ["m2-tutorial"],
      "estMinutes": 12,
      "methodId": null
    },
    {
      "node_id": "m2-demo:func",
      "summary": "把一段逻辑收成可复用的、带名字的调用单元。",
      "outcomes": ["能定义并调用一个函数", "能说明参数与返回值的传递"],
      "resources": [
        {
          "kind": "规范",
          "title": "The Python Tutorial §4.8",
          "url": "https://docs.python.org/3/tutorial/controlflow.html#defining-functions",
          "license": "PSF-2.0",
          "lang": "en"
        }
      ],
      "aliases": ["函数"],
      "keywords": ["function", "argument"],
      "body": "`def` 创建一个函数对象并绑定名字。",
      "steps": [
        { "operator": "example", "instruction": "看 §4.8 的 `fib` 例子，标出形参与实参。", "phase": "first" },
        { "operator": "practice", "instruction": "写一个把列表元素加倍的函数并调用它。", "phase": "both" },
        { "operator": "explain", "instruction": "向别人解释参数是怎么传进函数的。", "phase": "both" }
      ],
      "selfCheck": ["能说清形参与实参的对应"],
      "criteria": [{ "id": "c1", "statement": "能独立写出带返回值且有参数的函数，并说明调用时的绑定过程" }],
      "quiz": [
        {
          "id": "q1",
          "criterion_id": "c1",
          "type": "fill",
          "prompt": "`def f(x): return x * 2` 之后 `f(3)` 得到 ____",
          "answer": "6",
          "judge": "auto"
        }
      ],
      "source_refs": ["m2-tutorial"],
      "estMinutes": 15
    },
    {
      "node_id": "m2-demo:closure",
      "summary": "函数记住它被定义时所在的作用域。",
      "outcomes": ["能构造一个计数器闭包"],
      "resources": [],
      "aliases": ["闭包"],
      "keywords": ["closure", "scope"],
      "body": "闭包是函数与其词法环境的组合。",
      "steps": [
        { "operator": "read", "instruction": "读闭包一节。", "phase": "first" },
        { "operator": "do", "instruction": "写一个返回计数器函数的工厂。", "phase": "both" }
      ],
      "selfCheck": ["能说明为什么内层函数看得到外层变量"],
      "criteria": [{ "id": "c1", "statement": "能手写一个计数器闭包并解释其状态保存在哪" }],
      "quiz": [
        {
          "id": "q1",
          "criterion_id": "c1",
          "type": "code",
          "prompt": "实现 `make_counter()`，每次调用返回的值递增 1",
          "answer": "def make_counter():\n    n = 0\n    def step():\n        nonlocal n\n        n += 1\n        return n\n    return step",
          "judge": "auto"
        }
      ],
      "source_refs": ["m2-tutorial"],
      "estMinutes": 25
    },
    {
      "node_id": "m2-demo:typing",
      "summary": "从报错文本里读出「谁、在哪、为什么」。",
      "outcomes": ["能定位报错指的行", "能区分语法错与运行错"],
      "resources": [],
      "aliases": ["读栈"],
      "keywords": ["traceback", "error"],
      "body": "从下往上读栈：最后一行是错误类型与消息，往上是调用链。",
      "steps": [{ "operator": "practice", "instruction": "拿一个真实报错，逐行标出含义。", "phase": "both" }],
      "selfCheck": ["能说出 traceback 最后一行是什么"],
      "criteria": [],
      "quiz": [],
      "source_refs": [],
      "estMinutes": 10
    },
    {
      "node_id": "m2-demo:debug",
      "summary": "让程序停在你关心的那一行。",
      "outcomes": ["能下断点并查看局部变量"],
      "resources": [],
      "aliases": ["断点"],
      "keywords": ["breakpoint", "debugger"],
      "body": "断点的价值是「停住之后能改看什么」，不是「停住」本身。",
      "steps": [{ "operator": "do", "instruction": "在循环里下一次断点，观察每轮变量。", "phase": "both" }],
      "selfCheck": ["能用条件断点跳过前 99 次"],
      "criteria": [{ "id": "c1", "statement": "能用条件断点定位第 100 次迭代才出现的错误" }],
      "quiz": [
        {
          "id": "q1",
          "criterion_id": "c1",
          "type": "freeform",
          "prompt": "说明你会把断点下在哪一行、条件写什么",
          "answer": "下在循环体内可疑语句，条件写 i == 99",
          "judge": "self"
        }
      ],
      "source_refs": [],
      "estMinutes": 20
    },
    {
      "node_id": "m2-demo:refactor",
      "summary": "在不改变行为的前提下改善结构。",
      "outcomes": ["能识别一次重构的边界"],
      "resources": [],
      "aliases": ["重构"],
      "keywords": ["refactor"],
      "body": "重构的前提是有一张能告诉你「行为没变」的网。",
      "steps": [
        { "operator": "example", "instruction": "读一个「提取函数」的前后对比。", "phase": "first" },
        { "operator": "explain", "instruction": "讲清这次重构为什么不改变行为。", "phase": "both" }
      ],
      "selfCheck": ["能指出哪一行是这次重构的边界"],
      "criteria": [{ "id": "c1", "statement": "能在有测试的前提下完成一次提取函数重构" }],
      "quiz": [
        {
          "id": "q1",
          "criterion_id": "c1",
          "type": "choice",
          "prompt": "重构前最先要确认的是？",
          "answer": "有能覆盖该行为的测试",
          "judge": "auto"
        }
      ],
      "source_refs": ["m2-tutorial"],
      "estMinutes": 40,
      "methodId": "m2-recipe"
    }
  ],
