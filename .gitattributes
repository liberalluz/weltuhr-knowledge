# ════════════════════════════════════════════════════════════════════
# Line endings and binary handling — cross-platform consistency
#
# Goals:
#   1. Remove the "LF will be replaced by CRLF" noise from core.autocrlf=true;
#   2. Keep working-tree line endings identical on macOS / Windows / Linux,
#      so no diff is "line endings only";
#   3. Declare binaries explicitly: no newline conversion, no text diff.
#
# Spec: docs/specs/git-conventions.md §1.5 (line endings and binaries).
# Placed at the repo root by S0; check_s0.py asserts it exists and has eol=lf.
# ════════════════════════════════════════════════════════════════════

# ─── Default: text stored and checked out as LF ───────────────────
* text=auto eol=lf

# ─── Explicit text (defeat Git misdetection; always LF) ───────────
# App and toolchain sources
*.dart            text eol=lf
*.py              text eol=lf
*.cmake           text eol=lf
*.swift           text eol=lf
*.h               text eol=lf
*.cpp             text eol=lf
*.cc              text eol=lf
*.rc              text eol=lf
*.manifest        text eol=lf
# Content and config
*.md              text eol=lf
*.yaml            text eol=lf
*.yml             text eol=lf
*.json            text eol=lf
*.csv             text eol=lf
*.lock            text eol=lf
*.txt             text eol=lf
# Platform project files (generated by `flutter create`; still text)
*.plist           text eol=lf
*.xcconfig        text eol=lf
*.pbxproj         text eol=lf
*.xcscheme        text eol=lf
*.xcsettings      text eol=lf
*.xcworkspacedata text eol=lf
*.storyboard      text eol=lf
*.xib             text eol=lf
*.entitlements    text eol=lf

# ─── Windows scripts keep CRLF (none yet; for packaging / CI) ─────
*.bat             text eol=crlf
*.cmd             text eol=crlf
*.ps1             text eol=crlf

# ─── Repository hooks (extensionless bash scripts) ────────────────
# Under `*` `text=auto`, core.autocrlf=true rewrites these to CRLF on Windows,
# and a shebang ending in \r makes bash fail with "bad interpreter: No such
# file or directory" — looks like "the hook is missing", but it is line endings.
.githooks/**      text eol=lf

# ─── Binary: no newline conversion, no text diff ──────────────────
# Images (platform icons etc.)
*.png             binary
*.jpg             binary
*.jpeg            binary
*.gif             binary
*.webp            binary
*.ico             binary
*.icns            binary
# Fonts
*.ttf             binary
*.otf             binary
*.woff            binary
*.woff2           binary
# Audio / video
*.mp3             binary
*.m4a             binary
*.wav             binary
*.ogg             binary
*.opus            binary
*.mp4             binary
# Archives and executables
*.zip             binary
*.gz              binary
*.tar             binary
*.7z              binary
*.exe             binary
*.dll             binary
*.so              binary
*.dylib           binary
*.a               binary
*.lib             binary
# Databases and documents
*.db              binary
*.sqlite          binary
*.sqlite3         binary
*.pdf             binary
# Compressed source data (content/stars/source/bsc5.dat.gz)
*.gz              binary

# ─── Generated: host collapses the diff, no language stats ─────────
app/windows/**    linguist-generated=true
app/macos/**      linguist-generated=true
app/ios/**        linguist-generated=true
